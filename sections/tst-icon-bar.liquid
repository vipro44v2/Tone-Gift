<section class="section-{{ section.id }} tst-icon-bar color-{{ section.settings.color_scheme }} gradient">
  <style>
    .section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
      {% if section.settings.enable_custom_colors %}
        background: {{ section.settings.section_bg }};
        color: {{ section.settings.text_color }};
      {% else %}
        background: rgb(var(--color-background));
        color: rgb(var(--color-foreground));
      {% endif %}
    }

    .section-{{ section.id }} .tst-icon-bar__container {
      max-width: {{ section.settings.container_width }}px;
      margin: 0 auto;
      padding: 0 20px;
    }

    .section-{{ section.id }} .tst-icon-bar__heading-wrap {
      margin-bottom: {{ section.settings.heading_spacing_mobile }}px;
      text-align: {{ section.settings.heading_align }};
    }

    .section-{{ section.id }} .tst-icon-bar__heading {
      margin: 0;
      font-size: {{ section.settings.heading_size_mobile }}px;
      line-height: 1.15;
      font-weight: 700;
      {% if section.settings.enable_custom_colors %}
        color: {{ section.settings.heading_color }};
      {% else %}
        color: rgb(var(--color-foreground));
      {% endif %}
    }

    .section-{{ section.id }} .tst-icon-bar__slider {
      position: relative;
      width: 100%;
    }

    .section-{{ section.id }} .tst-icon-bar__track {
  {% if section.settings.enable_two_columns_mobile %}
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(8px, {{ section.settings.gap_mobile }}px, 16px);
    align-items: stretch;
    overflow: visible;
    padding: 0;
  {% elsif section.settings.enable_slider_mobile %}
    display: flex;
    gap: {{ section.settings.gap_mobile }}px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding: 0 0 6px;
  {% else %}
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_mobile }}, minmax(0, 1fr));
    gap: {{ section.settings.gap_mobile }}px;
    overflow: visible;
    padding: 0;
  {% endif %}
}

    .section-{{ section.id }} .tst-icon-bar__track::-webkit-scrollbar {
      display: none;
    }

    .section-{{ section.id }} .tst-icon-bar__item {
  min-width: 0;
  width: 100%;

  {% if section.settings.enable_slider_mobile and section.settings.enable_two_columns_mobile == false %}
    flex: 0 0 calc(
      (100% - ({{ section.settings.columns_mobile | minus: 1 }} * {{ section.settings.gap_mobile }}px))
      / {{ section.settings.columns_mobile }}
    );
    scroll-snap-align: start;
  {% endif %}
}

    .section-{{ section.id }} .tst-icon-bar__card {
      height: 100%;
      border-radius: {{ section.settings.card_radius }}px;
      padding: {{ section.settings.card_padding_mobile }}px;
      display: flex;
      flex-direction: column;
      align-items: {{ section.settings.card_align }};
      text-align: {{ section.settings.card_text_align }};
      box-shadow: 0 {{ section.settings.card_shadow_y }}px {{ section.settings.card_shadow_blur }}px rgba(0, 0, 0, {{ section.settings.card_shadow_opacity | divided_by: 100.0 }});
      {% if section.settings.enable_custom_colors %}
        background: {{ section.settings.card_bg }};
        color: {{ section.settings.card_text_color }};
        border: {{ section.settings.card_border_width }}px solid {{ section.settings.card_border_color }};
      {% else %}
        background: rgba(var(--color-foreground), 0.06);
        color: rgb(var(--color-foreground));
        border: {{ section.settings.card_border_width }}px solid rgba(var(--color-foreground), 0.12);
      {% endif %}
    }
    .section-{{ section.id }} .tst-icon-bar__card--vertical {
  flex-direction: column;
}

.section-{{ section.id }} .tst-icon-bar__card--horizontal {
  flex-direction: row;
  align-items: center;
  text-align: left;
}
.section-{{ section.id }} .tst-icon-bar__content {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.section-{{ section.id }} .tst-icon-bar__card--horizontal .tst-icon-bar__content {
  align-items: flex-start;
  text-align: left;
}

.section-{{ section.id }} .tst-icon-bar__card--horizontal .tst-icon-bar__card-title,
.section-{{ section.id }} .tst-icon-bar__card--horizontal .tst-icon-bar__card-text {
  text-align: left;
}

.section-{{ section.id }} .tst-icon-bar__card--horizontal .tst-icon-bar__icon {
  margin-bottom: 0;
  margin-right: {{ section.settings.icon_spacing }}px;
}

.section-{{ section.id }} .tst-icon-bar__card--horizontal .tst-icon-bar__card-text {
  margin-top: 6px;
}

.section-{{ section.id }} .tst-icon-bar__card--horizontal .tst-icon-bar__card-title,
.section-{{ section.id }} .tst-icon-bar__card--horizontal .tst-icon-bar__card-text {
  text-align: left;
}

@media screen and (max-width: 749px) {
  .section-{{ section.id }} .tst-icon-bar__card--horizontal {
    align-items: center;
  }

  .section-{{ section.id }} .tst-icon-bar__card--horizontal .tst-icon-bar__icon {
    margin-right: {{ section.settings.icon_spacing }}px;
  }
}

    .section-{{ section.id }} .tst-icon-bar__icon {
      width: {{ section.settings.icon_box_size_mobile }}px;
      height: {{ section.settings.icon_box_size_mobile }}px;
      border-radius: {{ section.settings.icon_box_radius }}px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: {{ section.settings.icon_spacing }}px;
      flex-shrink: 0;
      {% if section.settings.enable_custom_colors %}
        background: {{ section.settings.icon_bg }};
        color: {{ section.settings.icon_color }};
      {% else %}
        background: rgba(var(--color-button), 0.1);
        color: rgb(var(--color-button));
      {% endif %}
    }

    .section-{{ section.id }} .tst-icon-bar__icon svg,
    .section-{{ section.id }} .tst-icon-bar__custom-icon {
      width: {{ section.settings.icon_size_mobile }}px;
      height: {{ section.settings.icon_size_mobile }}px;
      object-fit: contain;
      display: block;
    }

    .section-{{ section.id }} .tst-icon-bar__card-title {
      margin: 0;
      font-size: {{ section.settings.card_heading_size_mobile }}px;
      line-height: 1.25;
      font-weight: 700;
      {% if section.settings.enable_custom_colors %}
        color: {{ section.settings.card_heading_color }};
      {% else %}
        color: rgb(var(--color-foreground));
      {% endif %}
    }

    .section-{{ section.id }} .tst-icon-bar__card-text {
      margin-top: {{ section.settings.card_text_spacing }}px;
      font-size: {{ section.settings.card_text_size_mobile }}px;
      line-height: 1.55;
      {% if section.settings.enable_custom_colors %}
        color: {{ section.settings.card_text_color }};
      {% else %}
        color: rgba(var(--color-foreground), 0.78);
      {% endif %}
    }

    .section-{{ section.id }} .tst-icon-bar__card-text p {
      margin: 0 0 10px;
    }

    .section-{{ section.id }} .tst-icon-bar__card-text p:last-child {
      margin-bottom: 0;
    }

    .section-{{ section.id }} .tst-icon-bar__arrows,
    .section-{{ section.id }} .tst-icon-bar__dots {
      display: none;
    }

    {% if section.settings.enable_slider_mobile and section.settings.show_arrows_mobile %}
      .section-{{ section.id }} .tst-icon-bar__arrows {
        display: flex;
      }
    {% endif %}

    {% if section.settings.enable_slider_mobile and section.settings.show_dots_mobile %}
      .section-{{ section.id }} .tst-icon-bar__dots {
        display: flex;
      }
    {% endif %}

    .section-{{ section.id }} .tst-icon-bar__arrows {
      justify-content: center;
      gap: 12px;
      margin-top: {{ section.settings.controls_spacing }}px;
    }

    .section-{{ section.id }} .tst-icon-bar__arrow {
      width: 42px;
      height: 42px;
      border-radius: 999px;
      border: 0;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      {% if section.settings.enable_custom_colors %}
        background: {{ section.settings.arrow_bg }};
        color: {{ section.settings.arrow_color }};
      {% else %}
        background: rgb(var(--color-button));
        color: rgb(var(--color-button-text));
      {% endif %}
    }

    .section-{{ section.id }} .tst-icon-bar__arrow[disabled] {
      opacity: 0.4;
      cursor: not-allowed;
    }

    .section-{{ section.id }} .tst-icon-bar__dots {
      justify-content: center;
      gap: 8px;
      margin-top: {{ section.settings.controls_spacing }}px;
    }

    .section-{{ section.id }} .tst-icon-bar__dot {
      width: 8px;
      height: 8px;
      border-radius: 999px;
      border: 0;
      padding: 0;
      cursor: pointer;
      opacity: 0.35;
      transition: all 0.25s ease;
      {% if section.settings.enable_custom_colors %}
        background: {{ section.settings.dot_color }};
      {% else %}
        background: rgb(var(--color-foreground));
      {% endif %}
    }

    .section-{{ section.id }} .tst-icon-bar__dot.is-active {
      opacity: 1;
      width: 22px;
    }
{% if section.settings.enable_two_columns_mobile %}
  @media screen and (max-width: 749px) {
    .section-{{ section.id }} .tst-icon-bar__container {
      padding-left: 14px;
      padding-right: 14px;
    }

    .section-{{ section.id }} .tst-icon-bar__item {
      display: flex;
      min-width: 0;
    }

    .section-{{ section.id }} .tst-icon-bar__card {
      width: 100%;
      min-height: 132px;
      padding: 16px 12px;
      justify-content: center;
      align-items: center;
      text-align: center;
      overflow: hidden;
    }

    /* Hai cột mobile luôn chuyển card sang dạng dọc để không bị chật */
    .section-{{ section.id }} .tst-icon-bar__card--horizontal,
    .section-{{ section.id }} .tst-icon-bar__card--vertical {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .section-{{ section.id }} .tst-icon-bar__content,
    .section-{{ section.id }} .tst-icon-bar__card--horizontal .tst-icon-bar__content {
      width: 100%;
      align-items: center;
      text-align: center;
    }

    .section-{{ section.id }} .tst-icon-bar__icon,
    .section-{{ section.id }} .tst-icon-bar__card--horizontal .tst-icon-bar__icon {
      width: {{ section.settings.icon_box_size_mobile }}px;
height: {{ section.settings.icon_box_size_mobile }}px;
      margin: 0 0 10px;
    }

    .section-{{ section.id }} .tst-icon-bar__icon svg,
.section-{{ section.id }} .tst-icon-bar__custom-icon {
  width: {{ section.settings.icon_size_mobile }}px;
  height: {{ section.settings.icon_size_mobile }}px;
  max-width: 100%;
  max-height: 100%;
}

    .section-{{ section.id }} .tst-icon-bar__card-title,
    .section-{{ section.id }} .tst-icon-bar__card--horizontal .tst-icon-bar__card-title {
      width: 100%;
      min-height: 2.5em;
      margin: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: clamp(
        13px,
        3.7vw,
        {{ section.settings.card_heading_size_mobile }}px
      );
      line-height: 1.25;
      text-align: center;
      overflow-wrap: anywhere;
    }

    .section-{{ section.id }} .tst-icon-bar__card-text,
    .section-{{ section.id }} .tst-icon-bar__card--horizontal .tst-icon-bar__card-text {
      width: 100%;
      margin-top: 7px;
      font-size: clamp(
        12px,
        3.2vw,
        {{ section.settings.card_text_size_mobile }}px
      );
      line-height: 1.4;
      text-align: center;
      overflow-wrap: anywhere;
    }

    .section-{{ section.id }} .tst-icon-bar__arrows,
    .section-{{ section.id }} .tst-icon-bar__dots {
      display: none !important;
    }
  }

  @media screen and (max-width: 374px) {
    .section-{{ section.id }} .tst-icon-bar__container {
      padding-left: 10px;
      padding-right: 10px;
    }

    .section-{{ section.id }} .tst-icon-bar__track {
      gap: 10px;
    }

    .section-{{ section.id }} .tst-icon-bar__card {
      min-height: 120px;
      padding: 14px 8px;
    }

    
  }
{% endif %}
    @media screen and (min-width: 750px) {
      .section-{{ section.id }} {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }

      .section-{{ section.id }} .tst-icon-bar__container {
        padding: 0 {{ section.settings.container_padding }}px;
      }

      .section-{{ section.id }} .tst-icon-bar__heading-wrap {
        margin-bottom: {{ section.settings.heading_spacing }}px;
      }

      .section-{{ section.id }} .tst-icon-bar__heading {
        font-size: {{ section.settings.heading_size }}px;
      }

      .section-{{ section.id }} .tst-icon-bar__track {
        {% if section.settings.enable_slider_desktop %}
          display: flex;
          gap: {{ section.settings.gap }}px;
          overflow-x: auto;
          scroll-snap-type: x mandatory;
          scroll-behavior: smooth;
          -webkit-overflow-scrolling: touch;
          scrollbar-width: none;
          padding: 0 0 8px;
        {% else %}
          display: grid;
          grid-template-columns: repeat({{ section.settings.columns_desktop }}, minmax(0, 1fr));
          gap: {{ section.settings.gap }}px;
          overflow: visible;
          padding: 0;
        {% endif %}
      }

      .section-{{ section.id }} .tst-icon-bar__item {
        {% if section.settings.enable_slider_desktop %}
          flex: 0 0 calc((100% - ({{ section.settings.columns_desktop | minus: 1 }} * {{ section.settings.gap }}px)) / {{ section.settings.columns_desktop }});
          scroll-snap-align: start;
        {% else %}
          flex: unset;
        {% endif %}
      }

      .section-{{ section.id }} .tst-icon-bar__card {
        padding: {{ section.settings.card_padding }}px;
      }

      .section-{{ section.id }} .tst-icon-bar__icon {
        width: {{ section.settings.icon_box_size }}px;
        height: {{ section.settings.icon_box_size }}px;
      }

      .section-{{ section.id }} .tst-icon-bar__icon svg,
      .section-{{ section.id }} .tst-icon-bar__custom-icon {
        width: {{ section.settings.icon_size }}px;
        height: {{ section.settings.icon_size }}px;
      }

      .section-{{ section.id }} .tst-icon-bar__card-title {
        font-size: {{ section.settings.card_heading_size }}px;
      }

      .section-{{ section.id }} .tst-icon-bar__card-text {
        font-size: {{ section.settings.card_text_size }}px;
      }

      .section-{{ section.id }} .tst-icon-bar__arrows,
      .section-{{ section.id }} .tst-icon-bar__dots {
        display: none;
      }

      {% if section.settings.enable_slider_desktop and section.settings.show_arrows_desktop %}
        .section-{{ section.id }} .tst-icon-bar__arrows {
          display: flex;
        }
      {% endif %}

      {% if section.settings.enable_slider_desktop and section.settings.show_dots_desktop %}
        .section-{{ section.id }} .tst-icon-bar__dots {
          display: flex;
        }
      {% endif %}
    }
  </style>

  <div class="tst-icon-bar__container">
    {% if section.settings.heading != blank %}
      <div class="tst-icon-bar__heading-wrap">
        <h2 class="tst-icon-bar__heading">{{ section.settings.heading }}</h2>
      </div>
    {% endif %}

    <div class="tst-icon-bar__slider" data-tst-icon-slider>
      <div class="tst-icon-bar__track" data-tst-track>
        {% for block in section.blocks %}
          <div class="tst-icon-bar__item" {{ block.shopify_attributes }}>
            <div class="tst-icon-bar__card tst-icon-bar__card--{{ section.settings.icon_layout }}">
              <div class="tst-icon-bar__icon">
                {% if block.settings.custom_icon != blank %}
                  {{
                    block.settings.custom_icon
                    | image_url: width: 160
                    | image_tag: loading: 'lazy', class: 'tst-icon-bar__custom-icon'
                  }}
                {% else %}
                  {% case block.settings.material_icon %}
                    {% when 'local_shipping' %}
                      <svg viewBox="0 0 24 24" fill="none"><path d="M3 6h11v9H3V6Z" stroke="currentColor" stroke-width="2"/><path d="M14 9h4l3 3v3h-7V9Z" stroke="currentColor" stroke-width="2"/><path d="M7 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4ZM17 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z" stroke="currentColor" stroke-width="2"/></svg>
                    {% when 'lock' %}
                      <svg viewBox="0 0 24 24" fill="none"><path d="M6 10h12v10H6V10Z" stroke="currentColor" stroke-width="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3" stroke="currentColor" stroke-width="2"/></svg>
                    {% when 'verified' %}
                      <svg viewBox="0 0 24 24" fill="none"><path d="m12 2 2.4 2.3 3.3-.2.8 3.2 2.8 1.8-1.4 3 1.4 3-2.8 1.8-.8 3.2-3.3-.2L12 22l-2.4-2.3-3.3.2-.8-3.2-2.8-1.8 1.4-3-1.4-3 2.8-1.8.8-3.2 3.3.2L12 2Z" stroke="currentColor" stroke-width="2"/><path d="m8 12 2.5 2.5L16 9" stroke="currentColor" stroke-width="2"/></svg>
                    {% when 'favorite' %}
                      <svg viewBox="0 0 24 24" fill="none"><path d="M12 21s-8-4.8-8-11a4.5 4.5 0 0 1 8-2.8A4.5 4.5 0 0 1 20 10c0 6.2-8 11-8 11Z" stroke="currentColor" stroke-width="2"/></svg>
                    {% else %}
                      <svg viewBox="0 0 24 24" fill="none"><path d="M20 6 9 17l-5-5" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  {% endcase %}
                {% endif %}
              </div>

              <div class="tst-icon-bar__content">
  {% if block.settings.title != blank %}
    <h3 class="tst-icon-bar__card-title">{{ block.settings.title }}</h3>
  {% endif %}

  {% if block.settings.text != blank %}
    <div class="tst-icon-bar__card-text rte">{{ block.settings.text }}</div>
  {% endif %}
</div>
            </div>
          </div>
        {% endfor %}
      </div>

      <div class="tst-icon-bar__arrows">
        <button class="tst-icon-bar__arrow" type="button" data-tst-prev aria-label="Previous">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M15 19 8 12l7-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <button class="tst-icon-bar__arrow" type="button" data-tst-next aria-label="Next">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="m9 5 7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>

      <div class="tst-icon-bar__dots" data-tst-dots></div>
    </div>
  </div>

  <script>
    (function () {
      const section = document.querySelector('.section-{{ section.id }}');
      if (!section) return;

      const track = section.querySelector('[data-tst-track]');
      const dotsWrap = section.querySelector('[data-tst-dots]');
      const prev = section.querySelector('[data-tst-prev]');
      const next = section.querySelector('[data-tst-next]');

      if (!track || track.dataset.tstReady === 'true') return;
      track.dataset.tstReady = 'true';

      function isDesktop() {
        return window.matchMedia('(min-width: 750px)').matches;
      }

      function sliderEnabled() {
  if (
    !isDesktop() &&
    {{ section.settings.enable_two_columns_mobile | json }}
  ) {
    return false;
  }

  return isDesktop()
    ? {{ section.settings.enable_slider_desktop | json }}
    : {{ section.settings.enable_slider_mobile | json }};
}

      function perView() {
        return isDesktop()
          ? {{ section.settings.columns_desktop | json }}
          : {{ section.settings.columns_mobile | json }};
      }

      function totalItems() {
        return track.children.length;
      }

      function pageWidth() {
        return track.clientWidth;
      }

      function maxPage() {
        return Math.max(0, Math.ceil(totalItems() / perView()) - 1);
      }

      function currentPage() {
        const width = pageWidth();
        if (!width) return 0;
        return Math.round(track.scrollLeft / width);
      }

      function goToPage(page) {
        if (!sliderEnabled()) return;
        const safePage = Math.max(0, Math.min(page, maxPage()));
        track.scrollTo({
          left: safePage * pageWidth(),
          behavior: 'smooth'
        });
      }

      function renderDots() {
        if (!dotsWrap) return;
        dotsWrap.innerHTML = '';

        if (!sliderEnabled()) return;

        for (let i = 0; i <= maxPage(); i++) {
          const dot = document.createElement('button');
          dot.type = 'button';
          dot.className = 'tst-icon-bar__dot';
          dot.setAttribute('aria-label', 'Go to slide ' + (i + 1));
          dot.addEventListener('click', function () {
            goToPage(i);
          });
          dotsWrap.appendChild(dot);
        }

        updateControls();
      }

      function updateControls() {
        if (!sliderEnabled()) return;

        const page = currentPage();
        const last = maxPage();

        if (prev) prev.disabled = page <= 0;
        if (next) next.disabled = page >= last;

        if (dotsWrap) {
          dotsWrap.querySelectorAll('.tst-icon-bar__dot').forEach(function (dot, index) {
            dot.classList.toggle('is-active', index === page);
          });
        }
      }

      if (prev) {
        prev.addEventListener('click', function () {
          goToPage(currentPage() - 1);
        });
      }

      if (next) {
        next.addEventListener('click', function () {
          goToPage(currentPage() + 1);
        });
      }

      track.addEventListener('scroll', function () {
        window.requestAnimationFrame(updateControls);
      });

      window.addEventListener('resize', function () {
        renderDots();
        updateControls();
      });

      renderDots();

      document.addEventListener('shopify:section:load', function (event) {
        if (event.detail && event.detail.sectionId === '{{ section.id }}') {
          renderDots();
        }
      });
    })();
  </script>
</section>

{% schema %}
{
  "name": "TST Icon bar",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_colors",
      "label": "Enable custom colors",
      "default": false
    },
    {
      "type": "header",
      "content": "Slider"
    },
    {
      "type": "checkbox",
      "id": "enable_slider_desktop",
      "label": "Enable slider desktop",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_slider_mobile",
      "label": "Enable slider mobile",
      "default": true
    },
    {
  "type": "checkbox",
  "id": "enable_two_columns_mobile",
  "label": "Show 2 columns on mobile",
  "info": "When enabled, the mobile slider is disabled and cards are displayed in a balanced 2-column grid.",
  "default": false
},
    {
      "type": "checkbox",
      "id": "show_arrows_desktop",
      "label": "Show arrows desktop",
      "default": false
    },
    {

<link
  rel="stylesheet"
  href="{{ 'component-card.css' | asset_url }}"
  media="print"
  onload="this.media='all'"
>

<link
  rel="stylesheet"
  href="{{ 'component-price.css' | asset_url }}"
  media="print"
  onload="this.media='all'"
>

<link
  rel="stylesheet"
  href="{{ 'section-related-products.css' | asset_url }}"
  media="print"
  onload="this.media='all'"
>

<noscript>
  {{ 'component-card.css' | asset_url | stylesheet_tag }}
  {{ 'component-price.css' | asset_url | stylesheet_tag }}
  {{ 'section-related-products.css' | asset_url | stylesheet_tag }}
</noscript>

{% if section.settings.image_shape == 'blob' %}
  <link
    rel="stylesheet"
    href="{{ 'mask-blobs.css' | asset_url }}"
    media="print"
    onload="this.media='all'"
  >
{% endif %}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  {%- if section.settings.enable_percentage_sale_badge -%}
    #RelatedProducts-{{ section.id }} .tst-sale-badge {
      position: relative;
      isolation: isolate;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 3.2rem;
      margin: 0;
      padding: 0.65rem 1.15rem;
      gap: 0.45rem;
      overflow: hidden;
      color: {{ section.settings.sale_badge_text_color }};
      background: linear-gradient(135deg, {{ section.settings.sale_badge_background }} 0%, {{ section.settings.sale_badge_gradient }} 100%);
      border: 1px solid rgba(255, 255, 255, 0.35);
      border-radius: {{ section.settings.sale_badge_radius }}px;
      box-shadow: 0 6px 18px rgba(0, 0, 0, 0.22), inset 0 1px 0 rgba(255, 255, 255, 0.28);
      font-size: {{ section.settings.sale_badge_font_size }}px;
      font-weight: 700;
      line-height: 1;
      letter-spacing: 0.015em;
      white-space: nowrap;
      text-transform: none;
      animation: tst-sale-badge-pulse-{{ section.id }} 1.8s ease-in-out infinite;
    }

    #RelatedProducts-{{ section.id }} .tst-sale-badge::after {
      content: '';
      position: absolute;
      top: -50%;
      bottom: -50%;
      left: -65%;
      z-index: -1;
      width: 45%;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.5), transparent);
      transform: skewX(-22deg);
      animation: tst-sale-badge-shine-{{ section.id }} 2.6s ease-in-out infinite;
      pointer-events: none;
    }

    #RelatedProducts-{{ section.id }} .tst-sale-badge__spark {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 0.9em;
      line-height: 1;
      animation: tst-sale-badge-spark-{{ section.id }} 1.25s ease-in-out infinite;
    }

    #RelatedProducts-{{ section.id }} .tst-sale-badge strong {
      color: inherit;
      font: inherit;
      font-weight: 800;
    }

    @keyframes tst-sale-badge-pulse-{{ section.id }} {
      0%,
      100% {
        transform: scale(1);
        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.22), inset 0 1px 0 rgba(255, 255, 255, 0.28);
        filter: brightness(1);
      }
      50% {
        transform: scale(1.055);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3), 0 0 0 4px rgba(255, 255, 255, 0.12), inset 0 1px 0 rgba(255, 255, 255, 0.35);
        filter: brightness(1.1);
      }
    }

    @keyframes tst-sale-badge-shine-{{ section.id }} {
      0%,
      42% {
        left: -65%;
      }
      72%,
      100% {
        left: 130%;
      }
    }

    @keyframes tst-sale-badge-spark-{{ section.id }} {
      0%,
      100% {
        opacity: 0.75;
        transform: rotate(0) scale(0.9);
      }
      50% {
        opacity: 1;
        transform: rotate(18deg) scale(1.15);
      }
    }

    @media screen and (max-width: 749px) {
      #RelatedProducts-{{ section.id }} .tst-sale-badge {
        min-height: 2.8rem;
        padding: 0.55rem 0.9rem;
        gap: 0.35rem;
        font-size: {{ section.settings.sale_badge_font_size_mobile }}px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      #RelatedProducts-{{ section.id }} .tst-sale-badge,
      #RelatedProducts-{{ section.id }} .tst-sale-badge::after,
      #RelatedProducts-{{ section.id }} .tst-sale-badge__spark {
        animation: none;
      }
    }
  {%- endif -%}

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <product-recommendations
    id="RelatedProducts-{{ section.id }}"
    class="related-products page-width section-{{ section.id }}-padding isolate{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
    data-url="{{ routes.product_recommendations_url }}?limit={{ section.settings.products_to_show }}"
    data-section-id="{{ section.id }}"
    data-product-id="{{ product.id }}"
  >
    {% if recommendations.performed and recommendations.products_count > 0 %}
      <h2 class="related-products__heading inline-richtext {{ section.settings.heading_size }}">
        {{ section.settings.heading }}
      </h2>
      <ul
        class="grid product-grid grid--{{ section.settings.columns_desktop }}-col-desktop grid--{{ section.settings.columns_mobile }}-col-tablet-down"
        role="list"
      >
        {% assign skip_card_product_styles = false %}
        {% for recommendation in recommendations.products %}
          {%- liquid
            assign tst_sale_percentage = 0

            if section.settings.enable_percentage_sale_badge and recommendation.available and recommendation.compare_at_price > recommendation.price
              assign tst_sale_saving = recommendation.compare_at_price | minus: recommendation.price
              assign tst_sale_percentage = tst_sale_saving | times: 100.0 | divided_by: recommendation.compare_at_price | round
            endif
          -%}
          <li
            class="grid__item"
            {%- if tst_sale_percentage > 0 %}
              data-tst-sale-percentage="{{ tst_sale_percentage }}"
            {%- endif %}
          >
            {% render 'card-product',
              card_product: recommendation,
              media_aspect_ratio: section.settings.image_ratio,
              image_shape: section.settings.image_shape,
              show_secondary_image: section.settings.show_secondary_image,
              show_vendor: section.settings.show_vendor,
              show_rating: section.settings.show_rating,
              skip_styles: skip_card_product_styles
            %}
          </li>
          {%- assign skip_card_product_styles = true -%}
        {% endfor %}
      </ul>
    {% endif %}
  </product-recommendations>
  {% if section.settings.image_shape == 'arch' %}
    {{ 'mask-arch.svg' | inline_asset_content }}
  {%- endif -%}
</div>

{%- if section.settings.enable_percentage_sale_badge -%}
  <script>
    (() => {
      const root = document.getElementById('RelatedProducts-{{ section.id }}');
      if (!root) return;

      const applySaleBadges = () => {
        root.querySelectorAll('[data-tst-sale-percentage]').forEach((card) => {
          const percentage = card.dataset.tstSalePercentage;
          const badge = card.querySelector('.card__badge .badge');

          if (!percentage || !badge || badge.classList.contains('tst-sale-badge')) return;

          badge.classList.add('tst-sale-badge');
          badge.setAttribute('aria-label', `Sale ${percentage} percent`);
          badge.innerHTML = `<span class="tst-sale-badge__spark" aria-hidden="true">✦</span><span>Sale</span><strong>${percentage}%</strong>`;
        });
      };

      applySaleBadges();

      if (root.tstSaleBadgeObserver) root.tstSaleBadgeObserver.disconnect();

      root.tstSaleBadgeObserver = new MutationObserver(applySaleBadges);
      root.tstSaleBadgeObserver.observe(root, { childList: true, subtree: true });
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.related-products.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",

    },
    {
      "type": "color",
      "id": "sale_badge_gradient",
      "label": "Badge gradient",
      "default": "#FF8A3D"
    },
    {
      "type": "color",
      "id": "sale_badge_text_color",
      "label": "Badge text",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "sale_badge_font_size",
      "min": 10,
      "max": 18,
      "step": 1,

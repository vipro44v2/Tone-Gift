{% liquid
  assign sid = section.id
%}

<section class="tst-compare section-{{ sid }}">
  <style>
    .section-{{ sid }} {
  background: {{ section.settings.bg_color }};
  padding-top: {{ section.settings.padding_top }}px;
  padding-bottom: {{ section.settings.padding_bottom }}px;
  overflow: hidden;
}

    .section-{{ sid }} .tst-compare__page {
      {% if section.settings.full_width %}
        max-width: none;
        padding-left: {{ section.settings.side_padding }}px;
        padding-right: {{ section.settings.side_padding }}px;
      {% else %}
        max-width: {{ section.settings.page_width }}px;
        margin: 0 auto;
        padding-left: {{ section.settings.side_padding }}px;
        padding-right: {{ section.settings.side_padding }}px;
      {% endif %}
    }

    .section-{{ sid }} .tst-compare__header {
      text-align: {{ section.settings.text_align }};
      margin-bottom: {{ section.settings.header_spacing }}px;
      color: {{ section.settings.text_color }};
    }

    .section-{{ sid }} .tst-compare__kicker {
      margin: 0 0 8px;
      font-size: {{ section.settings.kicker_size }}px;
      letter-spacing: .12em;
      text-transform: uppercase;
      font-weight: 700;
      color: {{ section.settings.kicker_color }};
    }

    .section-{{ sid }} .tst-compare__heading {
      margin: 0;
      font-size: {{ section.settings.heading_size }}px;
      line-height: 1.08;
      font-weight: 800;
      color: {{ section.settings.heading_color }};
    }

    .section-{{ sid }} .tst-compare__desc {
      max-width: 720px;
      margin: 14px {% if section.settings.text_align == 'center' %}auto{% elsif section.settings.text_align == 'right' %}0 0 0 auto{% else %}0{% endif %};
      font-size: {{ section.settings.desc_size }}px;
      line-height: 1.6;
      color: {{ section.settings.desc_color }};
    }

    .section-{{ sid }} .tst-compare__table-wrap {
      width: 100%;
      display: flex;
      justify-content: center;
    }

    .section-{{ sid }} .tst-compare__table {
      width: 100%;
      max-width: {{ section.settings.table_width }}px;
      border-collapse: separate;
      border-spacing: 0;
      table-layout: fixed;
      overflow: hidden;
      border-radius: {{ section.settings.radius }}px;
    }

    .section-{{ sid }} .tst-compare__table th,
    .section-{{ sid }} .tst-compare__table td {
      padding: {{ section.settings.cell_padding_y }}px {{ section.settings.cell_padding_x }}px;
      text-align: center;
      vertical-align: middle;
      font-size: {{ section.settings.cell_font_size }}px;
      line-height: 1.3;
    }

    .section-{{ sid }} .tst-compare__table th:first-child,
    .section-{{ sid }} .tst-compare__feature {
      width: {{ section.settings.feature_width }}%;
    }

   .section-{{ sid }} .tst-compare__brand {
  width: {{ section.settings.brand_width }}%;
  background: {{ section.settings.brand_bg }};
  color: {{ section.settings.brand_text }};
  border-top-left-radius: {{ section.settings.highlight_radius }}px;
  border-top-right-radius: {{ section.settings.highlight_radius }}px;
}

    .section-{{ sid }} .tst-compare__others {
      background: {{ section.settings.other_bg }};
      color: {{ section.settings.other_text }};
      font-size: {{ section.settings.others_font_size }}px !important;
      font-weight: 800;
    }

    .section-{{ sid }} .tst-compare__feature,
    .section-{{ sid }} .tst-compare__other-cell {
      background: {{ section.settings.feature_bg }};
      color: {{ section.settings.feature_text }};
    }

   .section-{{ sid }} .tst-compare__brand-cell {
  background: {{ section.settings.brand_bg }};
  color: {{ section.settings.brand_text }};
}

.section-{{ sid }} tbody tr:last-child .tst-compare__brand-cell {
  border-bottom-left-radius: {{ section.settings.highlight_radius }}px;
  border-bottom-right-radius: {{ section.settings.highlight_radius }}px;
}

    .section-{{ sid }} .tst-compare__feature {
      font-weight: 800;
    }

    {% if section.settings.show_separators %}
      .section-{{ sid }} .tst-compare__table tbody tr:not(:last-child) td {
        border-bottom: 1px solid {{ section.settings.separator_color }};
      }
    {% endif %}

    {% if section.settings.enable_zebra %}
      .section-{{ sid }} .tst-compare__table tbody tr:nth-child(even) .tst-compare__feature,
      .section-{{ sid }} .tst-compare__table tbody tr:nth-child(even) .tst-compare__other-cell {
        background: {{ section.settings.zebra_bg }};
      }
    {% endif %}

    

    .section-{{ sid }} .tst-compare__logo img {
      display: block;
      width: {{ section.settings.logo_width }}px;
      max-width: 100%;
      height: auto;
      margin: 0 auto;
    }

    .section-{{ sid }} .tst-compare__brand-title {
      font-size: {{ section.settings.brand_title_size }}px;
      font-weight: 800;
      line-height: 1.15;
    }

    .section-{{ sid }} .tst-compare__icon {
      width: {{ section.settings.icon_size }}px;
      height: {{ section.settings.icon_size }}px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      color: currentColor;
    }

    .section-{{ sid }} .tst-compare__icon svg {
      width: 100%;
      height: 100%;
      display: block;
      fill: currentColor;
    }

    .section-{{ sid }} .tst-compare__check {
      color: {{ section.settings.check_color }};
    }

    .section-{{ sid }} .tst-compare__cross {
      color: {{ section.settings.cross_color }};
    }

    {% if section.settings.enable_animation %}
      .section-{{ sid }} .tst-compare__table tbody tr {
        opacity: 0;
        transform: translateY(14px);
        transition: opacity .5s ease, transform .5s ease;
        transition-delay: calc(var(--row-index) * {{ section.settings.row_delay }}ms);
      }

      .section-{{ sid }}.is-visible .tst-compare__table tbody tr {
        opacity: 1;
        transform: none;
      }

      .section-{{ sid }} .tst-compare__icon {
        opacity: 0;
        transform: scale(.45);
      }

      .section-{{ sid }}.is-visible .tst-compare__icon {
        animation: tstComparePop-{{ sid }} .45s cubic-bezier(.34,1.56,.64,1) forwards;
        animation-delay: calc(250ms + var(--row-index) * {{ section.settings.row_delay }}ms);
      }

      @keyframes tstComparePop-{{ sid }} {
        to {
          opacity: 1;
          transform: scale(1);
        }
      }
    {% endif %}

    @media screen and (max-width: 749px) {
      .section-{{ sid }} {
        padding-top: {{ section.settings.mobile_padding_top }}px;
        padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
      }

      .section-{{ sid }} .tst-compare__page {
        padding-left: {{ section.settings.mobile_side_padding }}px;
        padding-right: {{ section.settings.mobile_side_padding }}px;
      }

      .section-{{ sid }} .tst-compare__heading {
        font-size: {{ section.settings.mobile_heading_size }}px;
      }

      .section-{{ sid }} .tst-compare__desc {
        font-size: {{ section.settings.mobile_desc_size }}px;
      }

      .section-{{ sid }} .tst-compare__table {
        table-layout: fixed;
      }

      .section-{{ sid }} .tst-compare__table th,
      .section-{{ sid }} .tst-compare__table td {
        padding: {{ section.settings.mobile_cell_padding_y }}px {{ section.settings.mobile_cell_padding_x }}px;
        font-size: {{ section.settings.mobile_cell_font_size }}px;
      }

      .section-{{ sid }} .tst-compare__table th:first-child,
      .section-{{ sid }} .tst-compare__feature {
        width: {{ section.settings.mobile_feature_width }}%;
      }

      .section-{{ sid }} .tst-compare__brand {
        width: {{ section.settings.mobile_brand_width }}%;
      }

      .section-{{ sid }} .tst-compare__logo img {
        width: {{ section.settings.mobile_logo_width }}px;
      }

      .section-{{ sid }} .tst-compare__icon {
        width: {{ section.settings.mobile_icon_size }}px;
        height: {{ section.settings.mobile_icon_size }}px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .section-{{ sid }} .tst-compare__table tbody tr,
      .section-{{ sid }} .tst-compare__icon {
        opacity: 1 !important;
        transform: none !important;
        animation: none !important;
        transition: none !important;
      }
    }
  </style>

  <div class="tst-compare__page">
    {% if section.settings.kicker != blank or section.settings.heading != blank or section.settings.description != blank %}
      <div class="tst-compare__header">
        {% if section.settings.kicker != blank %}
          <p class="tst-compare__kicker">{{ section.settings.kicker }}</p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="tst-compare__heading">{{ section.settings.heading }}</h2>
        {% endif %}

        {% if section.settings.description != blank %}
          <div class="tst-compare__desc">{{ section.settings.description }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="tst-compare__table-wrap">
      <table class="tst-compare__table">
        <thead>
          <tr>
            <th>&nbsp;</th>

            <th class="tst-compare__brand">
              {% if section.settings.brand_logo != blank %}
                <div class="tst-compare__logo">
                  {{
                    section.settings.brand_logo
                    | image_url: width: 500
                    | image_tag: loading: 'lazy', alt: section.settings.brand_title
                  }}
                </div>
              {% elsif section.settings.brand_title != blank %}
                <div class="tst-compare__brand-title">{{ section.settings.brand_title }}</div>
              {% endif %}
            </th>

            <th class="tst-compare__others">
              {{ section.settings.others_title }}
            </th>
          </tr>
        </thead>

        <tbody>
          {% for block in section.blocks %}
            <tr style="--row-index: {{ forloop.index0 }};" {{ block.shopify_attributes }}>
              <td class="tst-compare__feature">
                {{ block.settings.feature }}
              </td>

              <td class="tst-compare__brand-cell">
                <span class="tst-compare__icon tst-compare__check">
                  {% if block.settings.brand_icon == 'cross' %}
                    <svg viewBox="0 0 384 512"><path d="M342.6 150.6c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0L192 210.7 86.6 105.4c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3L146.7 256 41.4 361.4c-12.5 12.5-12.5 32.8 0 45.3s32.8 12.5 45.3 0L192 301.3l105.4 105.3c12.5 12.5 32.8 12.5 45.3 0s12.5-32.8 0-45.3L237.3 256l105.3-105.4z"/></svg>
                  {% else %}
                    <svg viewBox="0 0 448 512"><path d="M438.6 105.4c12.5 12.5 12.5 32.8 0 45.3l-256 256c-12.5 12.5-32.8 12.5-45.3 0l-128-128c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0L160 338.7 393.4 105.4c12.5-12.5 32.8-12.5 45.3 0z"/></svg>
                  {% endif %}
                </span>
              </td>

              <td class="tst-compare__other-cell">
                <span class="tst-compare__icon tst-compare__cross">
                  {% if block.settings.other_icon == 'check' %}
                    <svg viewBox="0 0 448 512"><path d="M438.6 105.4c12.5 12.5 12.5 32.8 0 45.3l-256 256c-12.5 12.5-32.8 12.5-45.3 0l-128-128c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0L160 338.7 393.4 105.4c12.5-12.5 32.8-12.5 45.3 0z"/></svg>
                  {% else %}
                    <svg viewBox="0 0 384 512"><path d="M342.6 150.6c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0L192 210.7 86.6 105.4c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3L146.7 256 41.4 361.4c-12.5 12.5-12.5 32.8 0 45.3s32.8 12.5 45.3 0L192 301.3l105.4 105.3c12.5 12.5 32.8 12.5 45.3 0s12.5-32.8 0-45.3L237.3 256l105.3-105.4z"/></svg>
                  {% endif %}
                </span>
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>

  {% if section.settings.enable_animation %}
    <script>
      (() => {
        const section = document.querySelector('.section-{{ sid }}');
        if (!section || section.dataset.tstCompareInit) return;
        section.dataset.tstCompareInit = 'true';

        if (!('IntersectionObserver' in window)) {
          section.classList.add('is-visible');
          return;
        }

        const observer = new IntersectionObserver((entries) => {
          if (entries[0].isIntersecting) {
            section.classList.add('is-visible');
            observer.disconnect();
          }
        }, { threshold: 0.25 });

        observer.observe(section);
      })();
    </script>
  {% endif %}
</section>


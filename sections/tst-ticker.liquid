<section class="tst-ticker section-{{ section.id }}">
  <style>
    .section-{{ section.id }} {
      width: 100%;
      overflow: hidden;
      background: {{ section.settings.bg_color }};
      color: {{ section.settings.text_color }};
      border-top: {{ section.settings.border_width }}px solid {{ section.settings.border_color }};
      border-bottom: {{ section.settings.border_width }}px solid {{ section.settings.border_color }};
      font-family: inherit;
      --tst-label-bg-rgb: {{ section.settings.label_bg_color.red }}, {{ section.settings.label_bg_color.green }}, {{ section.settings.label_bg_color.blue }};
    }

    .section-{{ section.id }} .tst-ticker__inner {
      height: {{ section.settings.height }}px;
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      overflow: hidden;
    }

    .section-{{ section.id }} .tst-ticker__side {
      position: relative;
      height: 100%;
      min-width: 0;
      overflow: hidden;
      display: flex;
      align-items: center;
    }

    .section-{{ section.id }} .tst-ticker__label {
      position: absolute;
      top: 0;
      height: 100%;
      z-index: 3;
      display: flex;
      align-items: center;
      background: rgba(var(--tst-label-bg-rgb), {{ section.settings.label_bg_opacity | divided_by: 100.0 }});
      color: {{ section.settings.label_color }};
      font-size: {{ section.settings.label_size }}px;
      font-weight: 800;
      line-height: 1;
      white-space: nowrap;
    }

    .section-{{ section.id }} .tst-ticker__side--left .tst-ticker__label {
      left: 0;
      padding: 0 {{ section.settings.label_padding }}px 0 0;
      margin-left:20px;
    }

    .section-{{ section.id }} .tst-ticker__side--right .tst-ticker__label {
      right: 0;
      padding: 0 0 0 {{ section.settings.label_padding }}px;
      margin-right:20px;
    }

    .section-{{ section.id }} .tst-ticker__viewport {
      width: 100%;
      height: 100%;
      overflow: hidden;
      display: flex;
      align-items: center;
    }

    .section-{{ section.id }} .tst-ticker__track {
      width: max-content;
      min-width: max-content;
      display: flex;
      align-items: center;
      white-space: nowrap;
      will-change: transform;
    }

    .section-{{ section.id }} .tst-ticker__group {
      display: flex;
      align-items: center;
      flex: 0 0 auto;
      white-space: nowrap;
    }

    .section-{{ section.id }} .tst-ticker__item {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding-right: {{ section.settings.item_gap }}px;
      font-size: {{ section.settings.text_size }}px;
      font-weight: {{ section.settings.text_weight }};
      line-height: 1;
      white-space: nowrap;
    }

    .section-{{ section.id }} .tst-ticker__side--left .tst-ticker__track {
      animation: tstTickerLeftToRight-{{ section.id }} {{ section.settings.left_speed }}s linear infinite;
    }

    .section-{{ section.id }} .tst-ticker__side--right .tst-ticker__track {
      animation: tstTickerRightToLeft-{{ section.id }} {{ section.settings.right_speed }}s linear infinite;
    }
    .section-{{ section.id }} .tst-ticker__side--left::after,
.section-{{ section.id }} .tst-ticker__side--right::before {
  content: "";
  position: absolute;
  top: 0;
  width: {{ section.settings.center_fade_width }}px;
  height: 100%;
  z-index: 2;
  pointer-events: none;
}

.section-{{ section.id }} .tst-ticker__side--left::after {
  right: 0;
  background: linear-gradient(to right, rgba(5,5,5,0), {{ section.settings.bg_color }});
}

.section-{{ section.id }} .tst-ticker__side--right::before {
  left: 0;
  background: linear-gradient(to left, rgba(5,5,5,0), {{ section.settings.bg_color }});
}
    .section-{{ section.id }} .tst-ticker__announcement {
      height: 100%;
      min-width: {{ section.settings.announcement_width }}px;
      padding: 0 {{ section.settings.announcement_padding }}px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: {{ section.settings.bg_color }};
      color: {{ section.settings.announcement_color }};
      font-size: {{ section.settings.announcement_size }}px;
      font-weight: 800;
      line-height: 1;
      white-space: nowrap;
      z-index: 4;
    }

    .section-{{ section.id }} .tst-ticker__announcement a {
      color: inherit;
      text-decoration: none;
    }

    .section-{{ section.id }} .tst-ticker__triangle {
      width: 0;
      height: 0;
      display: inline-block;
      flex: 0 0 auto;
    }

    .section-{{ section.id }} .tst-ticker__triangle--up {
      border-left: 5px solid transparent;
      border-right: 5px solid transparent;
      border-bottom: 9px solid {{ section.settings.up_color }};
    }

    .section-{{ section.id }} .tst-ticker__triangle--down {
      border-left: 5px solid transparent;
      border-right: 5px solid transparent;
      border-top: 9px solid {{ section.settings.down_color }};
    }

    {% if section.settings.pause_on_hover %}
      .section-{{ section.id }}:hover .tst-ticker__track {
        animation-play-state: paused;
      }
    {% endif %}

    @keyframes tstTickerLeftToRight-{{ section.id }} {
      from { transform: translateX(-50%); }
      to { transform: translateX(0); }
    }

    @keyframes tstTickerRightToLeft-{{ section.id }} {
      from { transform: translateX(0); }
      to { transform: translateX(-50%); }
    }

    @media (max-width: 749px) {
      .section-{{ section.id }} .tst-ticker__inner {
        height: auto;
        grid-template-columns: 1fr;
      }

      .section-{{ section.id }} .tst-ticker__side {
        height: {{ section.settings.mobile_ticker_height }}px;
      }

      .section-{{ section.id }} .tst-ticker__announcement {
        min-width: 100%;
        height: {{ section.settings.mobile_announcement_height }}px;
        font-size: {{ section.settings.mobile_announcement_size }}px;
        order: {% if section.settings.mobile_announcement_first %}-1{% else %}0{% endif %};
      }

      .section-{{ section.id }} .tst-ticker__label {
        font-size: {{ section.settings.mobile_label_size }}px;
      }

      .section-{{ section.id }} .tst-ticker__item {
        font-size: {{ section.settings.mobile_text_size }}px;
      }

      {% unless section.settings.show_left_mobile %}
        .section-{{ section.id }} .tst-ticker__side--left {
          display: none;
        }
      {% endunless %}

      {% unless section.settings.show_right_mobile %}
        .section-{{ section.id }} .tst-ticker__side--right {
          display: none;
        }
      {% endunless %}
    }
  </style>

  {% assign left_blocks = section.blocks | where: 'type', 'left_item' %}
  {% assign right_blocks = section.blocks | where: 'type', 'right_item' %}

  <div class="tst-ticker__inner">
    <div class="tst-ticker__side tst-ticker__side--left">
      {% if section.settings.left_label != blank %}
        <div class="tst-ticker__label">{{ section.settings.left_label }}</div>
      {% endif %}

      <div class="tst-ticker__viewport">
        <div class="tst-ticker__track">
          {% for copy in (1..2) %}
            <div class="tst-ticker__group">
              {% for repeat in (1..4) %}
                {% for block in left_blocks %}
                  {% if block.settings.text != blank %}
                    <strong class="tst-ticker__item" {{ block.shopify_attributes }}>{{ block.settings.text }}</strong>
                  {% endif %}
                {% endfor %}
              {% endfor %}
            </div>
          {% endfor %}
        </div>
      </div>
    </div>

    <div class="tst-ticker__announcement">
      {% if section.settings.announcement_link != blank %}
        <a href="{{ section.settings.announcement_link }}">{{ section.settings.announcement_text }}</a>
      {% else %}
        {{ section.settings.announcement_text }}
      {% endif %}
    </div>

    <div class="tst-ticker__side tst-ticker__side--right">
      <div class="tst-ticker__viewport">
        <div class="tst-ticker__track">
          {% for copy in (1..2) %}
            <div class="tst-ticker__group">
              {% for repeat in (1..4) %}
                {% for block in right_blocks %}
                  {% if block.settings.text != blank %}
                    <strong class="tst-ticker__item" {{ block.shopify_attributes }}>
                      {% if block.settings.trend == 'up' %}
                        <span class="tst-ticker__triangle tst-ticker__triangle--up"></span>
                      {% elsif block.settings.trend == 'down' %}
                        <span class="tst-ticker__triangle tst-ticker__triangle--down"></span>
                      {% endif %}
                      {{ block.settings.text }}
                    </strong>
                  {% endif %}
                {% endfor %}
              {% endfor %}
            </div>
          {% endfor %}
        </div>
      </div>

      {% if section.settings.right_label != blank %}
        <div class="tst-ticker__label">{{ section.settings.right_label }}</div>
      {% endif %}
    </div>
  </div>

  {% schema %}
  {
    "name": "TST Ticker",
    "settings": [
      {
        "type": "range",
        "id": "height",
        "label": "Desktop height",
        "min": 18,
        "max": 60,
        "step": 1,
        "unit": "px",
        "default": 22
      },
      {
        "type": "color",
        "id": "bg_color",
        "label": "Background",
        "default": "#050505"
      },
      {
        "type": "color",
        "id": "text_color",
        "label": "Text color",
        "default": "#ffffff"
      },
      {
        "type": "color",
        "id": "border_color",
        "label": "Border color",
        "default": "#2b2b2b"
      },
      {
        "type": "range",
        "id": "border_width",
        "label": "Border width",
        "min": 0,
        "max": 3,
        "step": 1,
        "unit": "px",
        "default": 1
      },
      {
        "type": "text",
        "id": "left_label",
        "label": "Left label",
        "default": "Now Listening"
      },
      {
        "type": "text",
        "id": "right_label",
        "label": "Right label",
        "default": "Trending Coffees"
      },
      {
        "type": "color",
        "id": "label_color",
        "label": "Label color",
        "default": "#ffffff"
      },
      {
  "type": "color",
  "id": "label_bg_color",
  "label": "Label background color",
  "default": "#050505"
},
{
  "type": "range",
  "id": "label_bg_opacity",
  "label": "Label background opacity",
  "min": 0,
  "max": 100,
  "step": 5,
  "unit": "%",
  "default": 65
},
      {
        "type": "range",
        "id": "label_size",
        "label": "Label size",
        "min": 8,
        "max": 18,
        "step": 1,
        "unit": "px",
        "default": 12
      },
      {
        "type": "range",
        "id": "label_padding",
        "label": "Label padding",
        "min": 4,
        "max": 40,
        "step": 1,
        "unit": "px",
        "default": 8
      },
      {
        "type": "text",
        "id": "announcement_text",
        "label": "Announcement text",
        "default": "Free Shipping On Orders $40+"
      },
      {
        "type": "url",
        "id": "announcement_link",
        "label": "Announcement link"
      },
      {
        "type": "color",
        "id": "announcement_color",
        "label": "Announcement color",
        "default": "#ffffff"
      },
      {
        "type": "range",
        "id": "announcement_width",
        "label": "Announcement min width",
        "min": 180,
        "max": 600,
        "step": 10,
        "unit": "px",
        "default": 360
      },
      {
        "type": "range",
        "id": "announcement_padding",
        "label": "Announcement padding",
        "min": 8,
        "max": 80,
        "step": 2,
        "unit": "px",
        "default": 30
      },
      {
  "type": "range",
  "id": "center_fade_width",
  "label": "Center fade width",
  "min": 0,
  "max": 160,
  "step": 4,
  "unit": "px",
  "default": 56
},
      {
        "type": "range",
        "id": "announcement_size",
        "label": "Announcement size",
        "min": 8,
        "max": 18,
        "step": 1,
        "unit": "px",
        "default": 12
      },
      {
        "type": "range",
        "id": "left_speed",
        "label": "Left speed",
        "min": 5,
        "max": 80,
        "step": 1,
        "unit": "s",
        "default": 42
      },
      {
        "type": "range",
        "id": "right_speed",
        "label": "Right speed",
        "min": 5,
        "max": 80,
        "step": 1,
        "unit": "s",
        "default": 18
      },
      {
        "type": "range",
        "id": "item_gap",
        "label": "Item gap",
        "min": 10,
        "max": 80,
        "step": 1,
        "unit": "px",
        "default": 28
      },
      {
        "type": "range",
        "id": "text_size",
        "label": "Text size",
        "min": 8,
        "max": 18,
        "step": 1,
        "unit": "px",
        "default": 12
      },
      {
        "type": "select",
        "id": "text_weight",
        "label": "Text weight",
        "default": "500",
        "options": [
          { "value": "400", "label": "Regular" },
          { "value": "500", "label": "Medium" },
          { "value": "700", "label": "Bold" },
          { "value": "800", "label": "Extra bold" }
        ]
      },
      {
        "type": "checkbox",
        "id": "pause_on_hover",
        "label": "Pause on hover",
        "default": false
      },
      {
        "type": "color",
        "id": "up_color",
        "label": "Up triangle color",
        "default": "#00c800"
      },
      {
        "type": "color",
        "id": "down_color",
        "label": "Down triangle color",
        "default": "#ff0000"
      },
      {
        "type": "header",
        "content": "Mobile"
      },
      {
        "type": "checkbox",
        "id": "show_left_mobile",
        "label": "Show left ticker",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_right_mobile",
        "label": "Show right ticker",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "mobile_announcement_first",
        "label": "Announcement first",
        "default": true
      },
      {
        "type": "range",
        "id": "mobile_ticker_height",
        "label": "Mobile ticker height",
        "min": 20,
        "max": 60,
        "step": 1,
        "unit": "px",
        "default": 30
      },
      {
        "type": "range",
        "id": "mobile_announcement_height",
        "label": "Mobile announcement height",
        "min": 20,
        "max": 60,
        "step": 1,
        "unit": "px",
        "default": 30
      },
      {
        "type": "range",
        "id": "mobile_label_size",
        "label": "Mobile label size",
        "min": 8,
        "max": 16,
        "step": 1,
        "unit": "px",
        "default": 11
      },
      {
        "type": "range",
        "id": "mobile_text_size",
        "label": "Mobile text size",
        "min": 8,
        "max": 16,
        "step": 1,
        "unit": "px",
        "default": 11
      },
      {
        "type": "range",
        "id": "mobile_announcement_size",
        "label": "Mobile announcement size",
        "min": 8,
        "max": 16,
        "step": 1,
        "unit": "px",
        "default": 11
      }
    ],
    "blocks": [
      {
        "type": "left_item",
        "name": "Left item",
        "settings": [
          {
            "type": "text",
            "id": "text",
            "label": "Text",
            "default": "Radiohead"
          }
        ]
      },
      {
        "type": "right_item",
        "name": "Right item",
        "settings": [
          {
            "type": "text",
            "id": "text",
            "label": "Text",
            "default": "Power Nap"
          },
          {
            "type": "select",
            "id": "trend",
            "label": "Trend",
            "default": "up",
            "options": [
              { "value": "none", "label": "None" },
              { "value": "up", "label": "Up" },
              { "value": "down", "label": "Down" }
            ]
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "TST Ticker",
        "blocks": [
          { "type": "left_item", "settings": { "text": "Jeff Buckley" } },
          { "type": "left_item", "settings": { "text": "Radiohead" } },
          { "type": "left_item", "settings": { "text": "Foo Fighters" } },
          { "type": "left_item", "settings": { "text": "Mumford & Sons" } },
          { "type": "left_item", "settings": { "text": "Cage The Elephant" } },
          { "type": "left_item", "settings": { "text": "Yves Tumor" } },
          { "type": "left_item", "settings": { "text": "Tom Misch" } },
          { "type": "left_item", "settings": { "text": "Kingfishr" } },
          { "type": "right_item", "settings": { "text": "Power Nap", "trend": "up" } },
          { "type": "right_item", "settings": { "text": "Geometry", "trend": "down" } },
          { "type": "right_item", "settings": { "text": "Southern Weather", "trend": "down" } },
          { "type": "right_item", "settings": { "text": "Tropical Weather", "trend": "up" } },
          { "type": "right_item", "settings": { "text": "Cold Brew", "trend": "up" } }
        ]
      }
    ]
  }
  {% endschema %}
</section>
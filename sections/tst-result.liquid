<section class="section-{{ section.id }} tst-result color-{{ section.settings.color_scheme }} gradient">
  <style>
    .section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
      {% if section.settings.enable_custom_colors %}
        background: {{ section.settings.section_bg }};
        color: {{ section.settings.text_color }};
      {% else %}
        background: rgb(var(--color-background));
        color: rgb(var(--color-foreground));
      {% endif %}
    }

    .section-{{ section.id }} .tst-result__container {
      max-width: {{ section.settings.container_width }}px;
      margin: 0 auto;
      padding: 0 20px;
    }

    .section-{{ section.id }} .tst-result__grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: {{ section.settings.gap_mobile }}px;
      align-items: center;
    }

    .section-{{ section.id }} .tst-result__content {
      text-align: {{ section.settings.content_align }};
    }

    .section-{{ section.id }} .tst-result__heading {
      margin: 0;
      font-size: {{ section.settings.heading_size_mobile }}px;
      line-height: 1.15;
      font-weight: 700;
      {% if section.settings.enable_custom_colors %}
        color: {{ section.settings.heading_color }};
      {% else %}
        color: rgb(var(--color-foreground));
      {% endif %}
    }

    .section-{{ section.id }} .tst-result__description {
      margin-top: {{ section.settings.description_spacing }}px;
      font-size: {{ section.settings.description_size_mobile }}px;
      line-height: 1.6;
      {% if section.settings.enable_custom_colors %}
        color: {{ section.settings.text_color }};
      {% else %}
        color: rgb(var(--color-foreground));
      {% endif %}
    }

    .section-{{ section.id }} .tst-result__description p {
      margin: 0 0 12px;
    }

    .section-{{ section.id }} .tst-result__description p:last-child {
      margin-bottom: 0;
    }

    .section-{{ section.id }} .tst-result__box {
      border-radius: {{ section.settings.box_radius }}px;
      padding: {{ section.settings.box_padding_mobile }}px;
      box-shadow: 0 {{ section.settings.box_shadow_y }}px {{ section.settings.box_shadow_blur }}px rgba(0, 0, 0, {{ section.settings.box_shadow_opacity | divided_by: 100.0 }});
      {% if section.settings.enable_custom_colors %}
        background: {{ section.settings.box_bg }};
        border: {{ section.settings.box_border_width }}px solid {{ section.settings.box_border_color }};
      {% else %}
        background: rgb(var(--color-background));
        border: {{ section.settings.box_border_width }}px solid rgba(var(--color-foreground), 0.12);
      {% endif %}
    }

    .section-{{ section.id }} .tst-result__box-title {
      margin: 0 0 {{ section.settings.rows_spacing }}px;
      font-size: {{ section.settings.box_heading_size_mobile }}px;
      line-height: 1.2;
      font-weight: 700;
      text-align: {{ section.settings.box_heading_align }};
      {% if section.settings.enable_custom_colors %}
        color: {{ section.settings.box_heading_color }};
      {% else %}
        color: rgb(var(--color-foreground));
      {% endif %}
    }

    .section-{{ section.id }} .tst-result__rows {
      display: flex;
      flex-direction: column;
      gap: {{ section.settings.row_gap }}px;
    }

    .section-{{ section.id }} .tst-result__row {
      display: grid;
      grid-template-columns: auto 1fr;
      gap: {{ section.settings.row_column_gap }}px;
      align-items: center;
      padding-bottom: {{ section.settings.row_gap }}px;
      {% if section.settings.enable_custom_colors %}
        border-bottom: 1px solid {{ section.settings.divider_color }};
      {% else %}
        border-bottom: 1px solid rgba(var(--color-foreground), 0.12);
      {% endif %}
    }

    .section-{{ section.id }} .tst-result__row:last-child {
      padding-bottom: 0;
      border-bottom: 0;
    }

    .section-{{ section.id }} .tst-result__percentage {
      width: {{ section.settings.percent_size_mobile }}px;
      height: {{ section.settings.percent_size_mobile }}px;
      border-radius: 999px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      position: relative;
      {% if section.settings.enable_custom_colors %}
        background: conic-gradient({{ section.settings.accent_color }} var(--percentage), {{ section.settings.circle_bg }} 0);
      {% else %}
        background: conic-gradient(rgb(var(--color-button)) var(--percentage), rgba(var(--color-foreground), 0.12) 0);
      {% endif %}
    }

    .section-{{ section.id }} .tst-result__percentage::before {
      content: "";
      position: absolute;
      inset: {{ section.settings.circle_thickness }}px;
      border-radius: inherit;
      z-index: 1;
      {% if section.settings.enable_custom_colors %}
        background: {{ section.settings.box_bg }};
      {% else %}
        background: rgb(var(--color-background));
      {% endif %}
    }

    .section-{{ section.id }} .tst-result__percentage span {
      position: relative;
      z-index: 2;
      font-size: {{ section.settings.percent_font_size_mobile }}px;
      line-height: 1;
      font-weight: 800;
      {% if section.settings.enable_custom_colors %}
        color: {{ section.settings.percent_color }};
      {% else %}
        color: rgb(var(--color-foreground));
      {% endif %}
    }

    .section-{{ section.id }} .tst-result__text {
      font-size: {{ section.settings.row_text_size_mobile }}px;
      line-height: 1.5;
      {% if section.settings.enable_custom_colors %}
        color: {{ section.settings.row_text_color }};
      {% else %}
        color: rgb(var(--color-foreground));
      {% endif %}
    }

    .section-{{ section.id }} .tst-result__text p {
      margin: 0;
    }

    .section-{{ section.id }} .tst-result__caption {
      margin-top: {{ section.settings.caption_spacing }}px;
      font-size: {{ section.settings.caption_size_mobile }}px;
      line-height: 1.5;
      text-align: {{ section.settings.caption_align }};
      {% if section.settings.enable_custom_colors %}
        color: {{ section.settings.caption_color }};
      {% else %}
        color: rgba(var(--color-foreground), 0.75);
      {% endif %}
    }

    .section-{{ section.id }} .tst-result__caption p {
      margin: 0;
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }} {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }

      .section-{{ section.id }} .tst-result__container {
        padding: 0 {{ section.settings.container_padding }}px;
      }

      .section-{{ section.id }} .tst-result__grid {
        grid-template-columns: {{ section.settings.content_width }}% {{ 100 | minus: section.settings.content_width }}%;
        gap: {{ section.settings.gap }}px;
      }

      .section-{{ section.id }} .tst-result__heading {
        font-size: {{ section.settings.heading_size }}px;
      }

      .section-{{ section.id }} .tst-result__description {
        font-size: {{ section.settings.description_size }}px;
      }

      .section-{{ section.id }} .tst-result__box {
        padding: {{ section.settings.box_padding }}px;
      }

      .section-{{ section.id }} .tst-result__box-title {
        font-size: {{ section.settings.box_heading_size }}px;
      }

      .section-{{ section.id }} .tst-result__percentage {
        width: {{ section.settings.percent_size }}px;
        height: {{ section.settings.percent_size }}px;
      }

      .section-{{ section.id }} .tst-result__percentage span {
        font-size: {{ section.settings.percent_font_size }}px;
      }

      .section-{{ section.id }} .tst-result__text {
        font-size: {{ section.settings.row_text_size }}px;
      }

      .section-{{ section.id }} .tst-result__caption {
        font-size: {{ section.settings.caption_size }}px;
      }
    }
  </style>

  <div class="tst-result__container">
    <div class="tst-result__grid">
      <div class="tst-result__content">
        {% if section.settings.heading != blank %}
          <h2 class="tst-result__heading">{{ section.settings.heading }}</h2>
        {% endif %}

        {% if section.settings.description != blank %}
          <div class="tst-result__description rte">
            {{ section.settings.description }}
          </div>
        {% endif %}
      </div>

      <div class="tst-result__box">
        {% if section.settings.box_heading != blank %}
          <h3 class="tst-result__box-title">{{ section.settings.box_heading }}</h3>
        {% endif %}

        <div class="tst-result__rows">
          {% for block in section.blocks %}
            <div class="tst-result__row" {{ block.shopify_attributes }}>
              <div class="tst-result__percentage" style="--percentage: {{ block.settings.percentage }}%;">
                <span>{{ block.settings.percentage }}%</span>
              </div>

              {% if block.settings.text != blank %}
                <div class="tst-result__text rte">
                  {{ block.settings.text }}
                </div>
              {% endif %}
            </div>
          {% endfor %}
        </div>

        {% if section.settings.caption != blank %}
          <div class="tst-result__caption rte">
            {{ section.settings.caption }}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}

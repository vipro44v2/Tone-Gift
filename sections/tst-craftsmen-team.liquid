{% comment %}
  Section: Craftsmen Team
  - Tối đa 3 mục
  - Desktop hiển thị thấp dần từ trái sang phải
  - Default width sử dụng class page-width của theme
  - Full width sử dụng toàn bộ chiều rộng màn hình
  - Responsive mobile
{% endcomment %}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --craft-bg: {{ section.settings.background_color }};
    --craft-name-color: {{ section.settings.name_color }};
    --craft-role-color: {{ section.settings.role_color }};
    --craft-quote-color: {{ section.settings.quote_color }};
    --craft-line-color: {{ section.settings.line_color }};
    --craft-gap: {{ section.settings.desktop_gap }}px;
    --craft-mobile-gap: {{ section.settings.mobile_gap }}px;
    --craft-full-padding: {{ section.settings.full_width_padding }}px;
    --craft-mobile-padding: {{ section.settings.mobile_side_padding }}px;
  }

  #shopify-section-{{ section.id }} .craftsmen-team {
    width: 100%;
    overflow: hidden;
    background: var(--craft-bg);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .craftsmen-team__inner {
    width: 100%;
  }

  #shopify-section-{{ section.id }} .craftsmen-team__inner--full-width {
    padding-left: var(--craft-full-padding);
    padding-right: var(--craft-full-padding);
  }

  #shopify-section-{{ section.id }} .craftsmen-team__heading {
    margin: 0 0 {{ section.settings.heading_spacing }}px;
    color: {{ section.settings.heading_color }};
    font-size: clamp(
      {{ section.settings.heading_size_mobile }}px,
      4vw,
      {{ section.settings.heading_size_desktop }}px
    );
    font-weight: {{ section.settings.heading_weight }};
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  #shopify-section-{{ section.id }} .craftsmen-team__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: start;
    gap: var(--craft-gap);
  }

  #shopify-section-{{ section.id }} .craftsmen-team__item {
    min-width: 0;
  }

  /*
    Tạo hiệu ứng 3 mục thấp dần từ trái sang phải.
  */
  #shopify-section-{{ section.id }} .craftsmen-team__item:nth-child(1) {
    margin-top: 0;
  }

  #shopify-section-{{ section.id }} .craftsmen-team__item:nth-child(2) {
    margin-top: {{ section.settings.second_item_offset }}px;
  }

  #shopify-section-{{ section.id }} .craftsmen-team__item:nth-child(3) {
    margin-top: {{ section.settings.third_item_offset }}px;
  }

  #shopify-section-{{ section.id }} .craftsmen-team__image-wrap {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: #1a1a1a;
    border-radius: {{ section.settings.image_radius }}px;
  }

  #shopify-section-{{ section.id }} .craftsmen-team__image-wrap--portrait {
    aspect-ratio: 3 / 4;
  }

  #shopify-section-{{ section.id }} .craftsmen-team__image-wrap--tall {
    aspect-ratio: 4 / 5;
  }

  #shopify-section-{{ section.id }} .craftsmen-team__image-wrap--square {
    aspect-ratio: 1 / 1;
  }

  #shopify-section-{{ section.id }} .craftsmen-team__image,
  #shopify-section-{{ section.id }} .craftsmen-team__placeholder {
    display: block;
    width: 100%;
    height: 100%;
  }

  #shopify-section-{{ section.id }} .craftsmen-team__image {
    object-fit: cover;
    filter: grayscale({{ section.settings.grayscale }}%);
    transition:
      transform 0.5s ease,
      filter 0.35s ease;
  }

  #shopify-section-{{ section.id }} .craftsmen-team__item:hover .craftsmen-team__image {
    transform: scale({{ section.settings.hover_zoom | divided_by: 100.0 }});
    filter: grayscale({{ section.settings.grayscale_hover }}%);
  }

  #shopify-section-{{ section.id }} .craftsmen-team__placeholder {
    min-height: 350px;
    fill: #555;
    background: #1a1a1a;
  }

  #shopify-section-{{ section.id }} .craftsmen-team__content {
    padding-top: {{ section.settings.content_spacing }}px;
  }

  #shopify-section-{{ section.id }} .craftsmen-team__name {
    margin: 0;
    color: var(--craft-name-color);
    font-size: {{ section.settings.name_size }}px;
    font-weight: 700;
    line-height: 1.15;
  }

  #shopify-section-{{ section.id }} .craftsmen-team__role {
    margin: 4px 0 0;
    color: var(--craft-role-color);
    font-size: {{ section.settings.role_size }}px;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .craftsmen-team__quote {
    position: relative;
    margin: 12px 0 0;
    padding-left: 14px;
    color: var(--craft-quote-color);
    font-size: {{ section.settings.quote_size }}px;
    font-style: italic;
    line-height: 1.55;
  }

  #shopify-section-{{ section.id }} .craftsmen-team__quote::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: {{ section.settings.line_width }}px;
    background: var(--craft-line-color);
  }

  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .craftsmen-team__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    #shopify-section-{{ section.id }} .craftsmen-team__item:nth-child(3) {
      margin-top: 0;
    }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .craftsmen-team {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }

    #shopify-section-{{ section.id }} .craftsmen-team__inner,
    #shopify-section-{{ section.id }} .craftsmen-team__inner--full-width {
      padding-left: var(--craft-mobile-padding);
      padding-right: var(--craft-mobile-padding);
    }

    #shopify-section-{{ section.id }} .craftsmen-team__heading {
      margin-bottom: {{ section.settings.heading_spacing_mobile }}px;
    }

    #shopify-section-{{ section.id }} .craftsmen-team__grid {
      grid-template-columns: repeat({{ section.settings.mobile_columns }}, minmax(0, 1fr));
      gap: var(--craft-mobile-gap);
    }

    #shopify-section-{{ section.id }} .craftsmen-team__item:nth-child(1),
    #shopify-section-{{ section.id }} .craftsmen-team__item:nth-child(2),
    #shopify-section-{{ section.id }} .craftsmen-team__item:nth-child(3) {
      margin-top: 0;
    }

    #shopify-section-{{ section.id }} .craftsmen-team__content {
      padding-top: {{ section.settings.content_spacing_mobile }}px;
    }

    #shopify-section-{{ section.id }} .craftsmen-team__name {
      font-size: {{ section.settings.name_size_mobile }}px;
    }

    #shopify-section-{{ section.id }} .craftsmen-team__role {
      font-size: {{ section.settings.role_size_mobile }}px;
    }

    #shopify-section-{{ section.id }} .craftsmen-team__quote {
      margin-top: 10px;
      padding-left: 12px;
      font-size: {{ section.settings.quote_size_mobile }}px;
    }
  }

  @media screen and (max-width: 480px) {
    #shopify-section-{{ section.id }} .craftsmen-team__grid--mobile-2 {
      column-gap: 10px;
    }

    #shopify-section-{{ section.id }} .craftsmen-team__grid--mobile-2
      .craftsmen-team__quote {
      font-size: 11px;
      line-height: 1.45;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .craftsmen-team__image {
      transition: none;
    }
  }
{%- endstyle -%}

<section class="craftsmen-team">
  <div
    class="
      craftsmen-team__inner
      {% if section.settings.section_width == 'default' %}
        page-width
      {% else %}
        craftsmen-team__inner--full-width
      {% endif %}
    "
  >
    {% if section.settings.heading != blank %}
      <h2 class="craftsmen-team__heading">
        {{ section.settings.heading | escape }}
      </h2>
    {% endif %}

    <div
      class="
        craftsmen-team__grid
        craftsmen-team__grid--mobile-{{ section.settings.mobile_columns }}
      "
    >
      {% for block in section.blocks limit: 3 %}
        <article
          class="craftsmen-team__item"
          {{ block.shopify_attributes }}
        >
          <div
            class="
              craftsmen-team__image-wrap
              craftsmen-team__image-wrap--{{ section.settings.image_ratio }}
            "
          >
            {% if block.settings.image != blank %}
              {{
                block.settings.image
                | image_url: width: 1200
                | image_tag:
                  loading: 'lazy',
                  widths: '320, 480, 640, 800, 1000, 1200',
                  sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw',
                  class: 'craftsmen-team__image',
                  alt: block.settings.name
              }}
            {% else %}
              {{
                'person'
                | placeholder_svg_tag:
                  'craftsmen-team__placeholder placeholder-svg'
              }}
            {% endif %}
          </div>

          <div class="craftsmen-team__content">
            {% if block.settings.name != blank %}
              <h3 class="craftsmen-team__name">
                {{ block.settings.name | escape }}
              </h3>
            {% endif %}

            {% if block.settings.role != blank %}
              <p class="craftsmen-team__role">
                {{ block.settings.role | escape }}
              </p>
            {% endif %}

            {% if block.settings.quote != blank %}
              <div class="craftsmen-team__quote">
                {{ block.settings.quote }}
              </div>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>


{%- liquid
  assign section_class = 'section-' | append: section.id

  if section.settings.flip_horizontal
    assign scale_x = 'scaleX(-1)'
  else
    assign scale_x = 'scaleX(1)'
  endif

  if section.settings.flip_vertical
    assign scale_y = 'scaleY(-1)'
  else
    assign scale_y = 'scaleY(1)'
  endif
-%}

{% style %}
  .{{ section_class }} {
    --tst-divider-height-desktop: {{ section.settings.divider_height }}px;
    --tst-divider-height-mobile: {{ section.settings.divider_height_mobile }}px;
    --tst-shape-color: {{ section.settings.custom_shape_color }};
    --tst-bg-color: {{ section.settings.custom_background_color }};
  }

  .{{ section_class }}.tst-divider-wrapper {
    width: 100%;
    overflow: hidden;
  }

  .{{ section_class }} .tst-divider-top-padding {
    height: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
  }

  .{{ section_class }} .tst-divider-bottom-padding {
    height: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  .{{ section_class }} .tst-divider-shape {
    position: relative;
    width: 100%;
    line-height: 0;
    overflow: hidden;
    transform: {{ scale_x }} {{ scale_y }};
    background: var(--tst-bg-color);
  }

  .{{ section_class }} .tst-divider-shape svg {
    display: block;
    width: 100%;
    height: var(--tst-divider-height-mobile);
    color: var(--tst-shape-color);
  }

  .{{ section_class }} .tst-divider-top-padding,
  .{{ section_class }} .tst-divider-bottom-padding {
    background: var(--tst-bg-color);
  }

  {% if section.settings.flip_vertical %}
    .{{ section_class }} .tst-divider-top-padding {
      background: var(--tst-shape-color);
    }

    .{{ section_class }} .tst-divider-bottom-padding {
      background: var(--tst-bg-color);
    }
  {% else %}
    .{{ section_class }} .tst-divider-top-padding {
      background: var(--tst-bg-color);
    }

    .{{ section_class }} .tst-divider-bottom-padding {
      background: var(--tst-shape-color);
    }
  {% endif %}

  .{{ section_class }}.desktop-hidden {
    display: block;
  }

  .{{ section_class }}.mobile-hidden {
    display: none;
  }

  .{{ section_class }} .tst-waves-animated {
    width: 100%;
    min-height: var(--tst-divider-height-mobile);
    max-height: var(--tst-divider-height-mobile);
  }

  .{{ section_class }} .tst-parallax > use {
    animation: tst-wave-move-25 25s cubic-bezier(.55,.5,.45,.5) infinite;
  }

  .{{ section_class }} .tst-parallax > use:nth-child(1) {
    animation-delay: -2s;
    animation-duration: 7s;
    opacity: .7;
  }

  .{{ section_class }} .tst-parallax > use:nth-child(2) {
    animation-delay: -3s;
    animation-duration: 10s;
    opacity: .5;
  }

  .{{ section_class }} .tst-parallax > use:nth-child(3) {
    animation-delay: -4s;
    animation-duration: 13s;
    opacity: .3;
  }

  .{{ section_class }} .tst-parallax > use:nth-child(4) {
    animation-delay: -5s;
    animation-duration: 20s;
    opacity: 1;
  }

  @keyframes tst-wave-move-25 {
    0% {
      transform: translate3d(-90px, 0, 0);
    }
    100% {
      transform: translate3d(85px, 0, 0);
    }
  }

  @media screen and (min-width: 750px) {
    .{{ section_class }} .tst-divider-top-padding {
      height: {{ section.settings.padding_top }}px;
    }

    .{{ section_class }} .tst-divider-bottom-padding {
      height: {{ section.settings.padding_bottom }}px;
    }

    .{{ section_class }} .tst-divider-shape svg {
      height: var(--tst-divider-height-desktop);
    }

    .{{ section_class }} .tst-waves-animated {
      min-height: var(--tst-divider-height-desktop);
      max-height: var(--tst-divider-height-desktop);
    }

    .{{ section_class }}.desktop-hidden {
      display: none;
    }

    .{{ section_class }}.mobile-hidden {
      display: block;
    }
  }
{% endstyle %}

<div class="{{ section_class }} tst-divider-wrapper {{ section.settings.visibility }}">
  <div class="tst-divider-top-padding"></div>

  <div class="tst-divider-shape">
    {% case section.settings.shape %}

      {% when 'diagonal_1' %}
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 360 32" preserveAspectRatio="none">
          <polygon fill="currentColor" points="0 29.91 0 32 360 32 360 0 0 29.91"/>
        </svg>

      {% when 'diagonal_2' %}
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 64 1440 256" preserveAspectRatio="none">
          <path fill="currentColor" d="M0,288L1440,64L1440,320L0,320Z"></path>
        </svg>

      {% when 'curved_1' %}
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 360 74.65" preserveAspectRatio="none">
          <path fill="currentColor" d="M0,20.29,12,23.6A474.72,474.72,0,0,0,72,37c24,3.31,48,3.31,72-6.69S192,.29,216,7c24,6.43,48,40.18,72,50,24,10.18,48-3.57,60-10l12-6.69v40H0Z" transform="translate(0 -5.64)"/>

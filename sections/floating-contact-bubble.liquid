  <script>
    (() => {
      const root = document.getElementById('TstContactFloat-{{ section.id }}');
      if (!root || root.dataset.initialized === 'true') return;

      root.dataset.initialized = 'true';

      const toggle = root.querySelector('[data-contact-toggle]');
      const panel = root.querySelector('[data-contact-panel]');
      const closeButton = root.querySelector('[data-contact-close]');
      const hint = root.querySelector('[data-contact-hint]');
      const entranceEnabled = root.dataset.entranceEnabled === 'true';
      const hintEnabled = root.dataset.hintEnabled === 'true';
      const entranceDelay = Number(root.dataset.entranceDelay) || 0;
      const hintDelay = Number(root.dataset.hintDelay) || 0;
      const hintDuration = Number(root.dataset.hintDuration) || 5000;
      let closeTimer;
      let entranceTimer;
      let hintTimer;
      let hintHideTimer;
      let hintTransitionTimer;
      let nudgeTimer;

      const hideHint = (cancelFuture = true) => {
        if (cancelFuture) {
          window.clearTimeout(hintTimer);
        }

        window.clearTimeout(hintHideTimer);
        window.clearTimeout(hintTransitionTimer);
        window.clearTimeout(nudgeTimer);
        root.classList.remove('is-hinting');

        if (!hint || hint.hidden) return;

        hint.classList.remove('is-visible');
        hintTransitionTimer = window.setTimeout(() => {
          hint.hidden = true;
        }, 240);
      };

      const showHint = () => {
        if (!hint || toggle.getAttribute('aria-expanded') === 'true') return;

        hint.hidden = false;
        requestAnimationFrame(() => {
          hint.classList.add('is-visible');
          root.classList.add('is-hinting');
        });

        nudgeTimer = window.setTimeout(() => {
          root.classList.remove('is-hinting');
        }, 1500);

        hintHideTimer = window.setTimeout(() => {
          hideHint(false);
        }, hintDuration);
      };

      const openPanel = () => {
        hideHint(true);
        window.clearTimeout(closeTimer);
        panel.hidden = false;
        requestAnimationFrame(() => panel.classList.add('is-open'));
        toggle.setAttribute('aria-expanded', 'true');
      };

      const closePanel = (returnFocus = false) => {
        panel.classList.remove('is-open');
        toggle.setAttribute('aria-expanded', 'false');
        closeTimer = window.setTimeout(() => {
          panel.hidden = true;
        }, 220);
        if (returnFocus) toggle.focus();
      };

      const togglePanel = () => {
        if (toggle.getAttribute('aria-expanded') === 'true') {
          closePanel();
        } else {
          openPanel();
        }
      };

      const onDocumentClick = (event) => {
        if (!root.contains(event.target)) {
          if (toggle.getAttribute('aria-expanded') === 'true') closePanel();
          if (hint && !hint.hidden) hideHint(true);
        }
      };

      const onDocumentKeydown = (event) => {
        if (event.key !== 'Escape') return;

        if (toggle.getAttribute('aria-expanded') === 'true') {
          closePanel(true);
        } else if (hint && !hint.hidden) {
          hideHint(true);
          toggle.focus();
        }
      };

      const onSectionUnload = (event) => {
        if (event.detail.sectionId !== '{{ section.id }}') return;
        document.removeEventListener('click', onDocumentClick);
        document.removeEventListener('keydown', onDocumentKeydown);
        document.removeEventListener('shopify:section:unload', onSectionUnload);
        window.clearTimeout(closeTimer);
        window.clearTimeout(entranceTimer);
        window.clearTimeout(hintTimer);
        window.clearTimeout(hintHideTimer);
        window.clearTimeout(hintTransitionTimer);
        window.clearTimeout(nudgeTimer);
      };

      toggle.addEventListener('click', togglePanel);
      if (hint) hint.addEventListener('click', openPanel);
      closeButton.addEventListener('click', () => closePanel(true));
      document.addEventListener('click', onDocumentClick);
      document.addEventListener('keydown', onDocumentKeydown);
      document.addEventListener('shopify:section:unload', onSectionUnload);

      if (entranceEnabled) {
        entranceTimer = window.setTimeout(() => {
          toggle.classList.remove('tst-contact-float__launcher--entrance');
        }, entranceDelay + 900);
      }

      if (hintEnabled && hint) {
        const entranceDuration = entranceEnabled ? 800 : 0;
        const effectiveEntranceDelay = entranceEnabled ? entranceDelay : 0;
        hintTimer = window.setTimeout(showHint, effectiveEntranceDelay + entranceDuration + hintDelay);
      }
    })();
  </script>
{%- endif -%}


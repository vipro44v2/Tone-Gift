{%- if tst_has_custom_product_fields -%}
    <script>
      (() => {
        /*
         * Khởi tạo validation một lần cho:
         * - Add to Cart chính
         * - Buy it now
         * - Sticky Add to Cart
         * - Theme Editor reload
         */
        if (window.TSTCustomProductFieldValidationInitialized) {
          return;
        }

        window.TSTCustomProductFieldValidationInitialized = true;

        const CUSTOM_FIELD_SELECTOR = '[data-custom-product-field]';
        const STICKY_ROOT_SELECTOR = '[data-tst-sticky-atc]';

        const getErrorElement = (field) => {
          const errorId = field.dataset.errorId;

          if (!errorId) {
            return null;
          }

          return document.getElementById(errorId);
        };

        const showFieldError = (field, message) => {
          const errorElement = getErrorElement(field);

          field.setCustomValidity(message);
          field.classList.add('product-custom-text__input--error');
          field.setAttribute('aria-invalid', 'true');

          if (errorElement) {
            errorElement.textContent = message;
            errorElement.hidden = false;
            field.setAttribute('aria-describedby', errorElement.id);
          }
        };

        const clearFieldError = (field) => {
          const errorElement = getErrorElement(field);

          field.setCustomValidity('');
          field.classList.remove('product-custom-text__input--error');
          field.setAttribute('aria-invalid', 'false');

          if (errorElement) {
            errorElement.textContent = '';
            errorElement.hidden = true;
          }
        };

        const validateField = (field) => {
          if (!field || field.disabled) {
            return true;
          }

          clearFieldError(field);

          const value = field.value.trim();
          field.value = value;

          if (
            field.dataset.customRequired === 'true' &&
            value.length === 0
          ) {
            showFieldError(
              field,
              field.dataset.requiredMessage ||
                'Please complete this field.'
            );

            return false;
          }

          /*
           * Trường năm không bắt buộc vẫn có thể để trống.
           * Khi đã nhập thì phải đủ đúng 4 chữ số.
           */
          if (
            field.dataset.yearField === 'true' &&
            value.length > 0 &&
            !/^\d{4}$/.test(value)
          ) {
            showFieldError(
              field,
              field.dataset.patternMessage ||
                'Please enter a valid 4-digit year.'
            );

            return false;
          }

          return true;
        };

        const getFieldsForForm = (form) => {
          if (!(form instanceof HTMLFormElement)) {
            return [];
          }

          return Array.from(
            document.querySelectorAll(CUSTOM_FIELD_SELECTOR)
          ).filter((field) => field.form === form);
        };

        const focusFirstInvalidField = (field) => {
          if (!field) {
            return;
          }

          field.scrollIntoView({
            behavior: 'smooth',
            block: 'center'
          });

          window.setTimeout(() => {
            field.focus({
              preventScroll: true
            });

            field.reportValidity();
          }, 300);
        };

        const validateProductForm = (
          form,
          { focusInvalid = true } = {}
        ) => {
          const fields = getFieldsForForm(form);

          if (!fields.length) {
            return true;
          }

          let firstInvalidField = null;

          fields.forEach((field) => {
            const isValid = validateField(field);

            if (!isValid && !firstInvalidField) {
              firstInvalidField = field;
            }
          });

          if (!firstInvalidField) {
            return true;
          }

          if (focusInvalid) {
            focusFirstInvalidField(firstInvalidField);
          }

          return false;
        };

        const stopAction = (event) => {
          event.preventDefault();
          event.stopPropagation();
          event.stopImmediatePropagation();
        };

        const getMainFormFromStickyRoot = (stickyRoot) => {
          if (!(stickyRoot instanceof HTMLElement)) {
            return null;
          }

          const formId = stickyRoot.dataset.productFormId;

          if (!formId) {
            return null;
          }

          const form = document.getElementById(formId);

          return form instanceof HTMLFormElement ? form : null;
        };

        /*
         * Nếu Sticky ATC sử dụng một form riêng, sao chép các line item
         * properties từ form sản phẩm chính sang form sticky trước khi gửi.
         */
        const syncCustomPropertiesToTargetForm = (
          sourceForm,
          targetForm
        ) => {
          if (
            !(sourceForm instanceof HTMLFormElement) ||
            !(targetForm instanceof HTMLFormElement) ||
            sourceForm === targetForm
          ) {
            return;
          }

          targetForm
            .querySelectorAll('[data-tst-synced-custom-property]')
            .forEach((input) => input.remove());

          getFieldsForForm(sourceForm).forEach((field) => {
            if (!field.name) {
              return;
            }

            const hiddenInput = document.createElement('input');

            hiddenInput.type = 'hidden';
            hiddenInput.name = field.name;
            hiddenInput.value = field.value.trim();
            hiddenInput.dataset.tstSyncedCustomProperty = 'true';

            targetForm.appendChild(hiddenInput);
          });
        };

        const validateStickyButton = (clickedElement, event) => {
          const stickyRoot = clickedElement.closest(
            STICKY_ROOT_SELECTOR
          );

          if (!stickyRoot) {
            return false;
          }

          /*
           * Các chế độ chỉ cuộn trang không cần validation.
           */
          if (
            stickyRoot.dataset.stickyFunction &&
            stickyRoot.dataset.stickyFunction !== 'add_to_cart'
          ) {
            return false;
          }

          const stickyButton = clickedElement.closest(
            'button, input[type="submit"], [role="button"]'
          );

          if (!stickyButton || !stickyRoot.contains(stickyButton)) {
            return false;
          }

          const buttonType = (
            stickyButton.getAttribute('type') || ''
          ).toLowerCase();

          const buttonName = (
            stickyButton.getAttribute('name') || ''
          ).toLowerCase();

          const buttonId = (
            stickyButton.id || ''
          ).toLowerCase();

          const buttonClass = (
            typeof stickyButton.className === 'string'
              ? stickyButton.className
              : ''
          ).toLowerCase();

          const buttonText = (
            stickyButton.textContent || ''
          ).trim().toLowerCase();

          const configuredLabel = (
            stickyRoot.dataset.stickyButtonLabel || ''
          ).trim().toLowerCase();

          const isStickyAddButton =
            buttonType === 'submit' ||
            buttonName === 'add' ||
            buttonId.includes('add-to-cart') ||
            buttonClass.includes('add-to-cart') ||
            buttonClass.includes('sticky-atc__button') ||
            buttonClass.includes('sticky-atc-button') ||
            (
              configuredLabel.length > 0 &&
              buttonText.includes(configuredLabel)
            );

          /*
           * Không validation khi khách chỉ đổi variant hoặc bấm
           * các control khác bên trong sticky bar.
           */
          if (!isStickyAddButton) {
            return false;
          }

          const mainForm = getMainFormFromStickyRoot(stickyRoot);

          if (!mainForm) {
            return false;
          }

          if (!validateProductForm(mainForm)) {
            stopAction(event);
            return true;
          }

          const stickyForm =
            stickyButton.form ||
            stickyButton.closest('form') ||
            stickyRoot.querySelector('form');

          syncCustomPropertiesToTargetForm(mainForm, stickyForm);

          /*
           * Đã nhận diện click Sticky ATC nhưng dữ liệu hợp lệ:
           * không chặn event, để logic của sticky tiếp tục chạy.
           */
          return true;
        };

        /*
         * Bắt submit trước AJAX handler của theme.
         */
        document.addEventListener(
          'submit',
          (event) => {
            const form = event.target;

            if (!(form instanceof HTMLFormElement)) {
              return;
            }

            /*
             * Nếu đây là form riêng của Sticky ATC, dùng form sản phẩm
             * chính để validation rồi đồng bộ properties sang form sticky.
             */
            const stickyRoot = form.closest(STICKY_ROOT_SELECTOR);

            if (stickyRoot) {
              if (
                stickyRoot.dataset.stickyFunction &&
                stickyRoot.dataset.stickyFunction !== 'add_to_cart'
              ) {
                return;
              }

              const mainForm = getMainFormFromStickyRoot(stickyRoot);

              if (
                mainForm &&
                !validateProductForm(mainForm)
              ) {
                stopAction(event);
                return;
              }

              if (mainForm) {
                syncCustomPropertiesToTargetForm(mainForm, form);
              }

              return;
            }

            if (!validateProductForm(form)) {
              stopAction(event);
            }
          },
          true
        );

        /*
         * Bắt click Add to Cart, Buy it now và Sticky Add to Cart.
         */
        document.addEventListener(
          'click',
          (event) => {
            const clickedElement = event.target;

            if (!(clickedElement instanceof Element)) {
              return;
            }

            /*
             * Sticky ATC được kiểm tra trước vì button có thể là type="button"
             * và không thuộc trực tiếp product form chính.
             */
            if (validateStickyButton(clickedElement, event)) {
              return;
            }

            const button = clickedElement.closest(
              'button, input[type="submit"], .shopify-payment-button__button'
            );

            if (!button || button.disabled) {
              return;
            }

            const isDynamicCheckout = Boolean(
              button.closest('.shopify-payment-button')
            );

            const isSubmitInput =
              button.matches('input[type="submit"]');

            const isSubmitButton =
              button.tagName === 'BUTTON' &&
              (
                !button.hasAttribute('type') ||
                button.getAttribute('type') === 'submit'
              );

            if (
              !isDynamicCheckout &&
              !isSubmitInput &&
              !isSubmitButton
            ) {
              return;
            }

            const form =
              button.form ||
              button.closest('form');

            if (!(form instanceof HTMLFormElement)) {
              return;
            }

            if (!validateProductForm(form)) {
              stopAction(event);
            }
          },
          true
        );

        /*
         * Chỉ cho trường năm nhận tối đa 4 chữ số
         * và xóa lỗi ngay khi khách tiếp tục nhập.
         */
        document.addEventListener('input', (event) => {
          const field = event.target;

          if (
            !(field instanceof HTMLInputElement) ||
            !field.matches(CUSTOM_FIELD_SELECTOR)
          ) {
            return;
          }

          if (field.dataset.yearField === 'true') {
            field.value = field.value
              .replace(/\D/g, '')
              .slice(0, 4);
          }

          clearFieldError(field);
        });

        /*
         * Kiểm tra lại khi rời khỏi ô.
         */
        document.addEventListener(
          'blur',
          (event) => {
            const field = event.target;

            if (
              !(field instanceof HTMLInputElement) ||
              !field.matches(CUSTOM_FIELD_SELECTOR)
            ) {
              return;
            }

            if (
              field.dataset.customRequired === 'true' ||
              field.value.trim().length > 0
            ) {
              validateField(field);
            }
          },
          true
        );

        /*
         * Cho phép code khác trong theme gọi validation khi cần:
         * window.TSTCustomProductFields.validate(formId)
         */
        window.TSTCustomProductFields = {
          validate(formId, options = {}) {
            const form = document.getElementById(formId);

            if (!(form instanceof HTMLFormElement)) {
              return true;
            }

            return validateProductForm(form, options);
          }
        };
      })();
    </script>
{%- endif -%}


<product-info
  id="MainProduct-{{ section.id }}"
  class="section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }}"
  data-section="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-update-url="true"
  data-url="{{ product.url }}"
  {% if section.settings.image_zoom == 'hover' %}
    data-zoom-on-hover
  {% endif %}
>
  {{ 'section-main-product.css' | asset_url | stylesheet_tag }}
  <link rel="stylesheet" href="{{ 'component-accordion.css' | asset_url }}" media="print" onload="this.media='all'">
  <noscript>{{ 'component-accordion.css' | asset_url | stylesheet_tag }}</noscript>
  {{ 'component-price.css' | asset_url | stylesheet_tag }}
  {{ 'component-slider.css' | asset_url | stylesheet_tag }}
  {{ 'component-rating.css' | asset_url | stylesheet_tag }}
  <link rel="stylesheet" href="{{ 'component-deferred-media.css' | asset_url }}" media="print" onload="this.media='all'">
  <noscript>{{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}</noscript>
  {{ 'shrine-product-info.css' | asset_url | stylesheet_tag }}

{%- assign product_upsell_blocks = section.blocks | where: 'type', 'product_upsell' -%}
{%- assign tst_price_block = section.blocks | where: 'type', 'price' | first -%}
{%- assign tst_custom_text_blocks = section.blocks | where: 'type', 'custom_text' -%}
{%- assign tst_has_custom_product_fields = false -%}
{%- for tst_custom_text_block in tst_custom_text_blocks -%}
  {%- if tst_custom_text_block.settings.enable_custom_text or tst_custom_text_block.settings.enable_custom_year -%}
    {%- assign tst_has_custom_product_fields = true -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}
{%- if product_upsell_blocks.size > 0 -%}
  {{ 'dawn-product-upsell.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'dawn-product-upsell.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

  {% unless product.has_only_default_variant %}
    {{ 'component-product-variant-picker.css' | asset_url | stylesheet_tag }}
    {{ 'component-swatch-input.css' | asset_url | stylesheet_tag }}
    {{ 'component-swatch.css' | asset_url | stylesheet_tag }}
  {% endunless %}
  {%- if product.quantity_price_breaks_configured? -%}
    {{ 'component-volume-pricing.css' | asset_url | stylesheet_tag }}
  {%- endif -%}

  {%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }

    {%- if tst_price_block.settings.enable_percentage_sale_badge -%}
      #MainProduct-{{ section.id }} .tst-product-price-block {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.9rem;
      }

      #MainProduct-{{ section.id }} .tst-product-price-block > .price {
        margin: 0;
      }

      #MainProduct-{{ section.id }} .tst-product-price-block .price__badge-sale {
        display: none;
      }

      #MainProduct-{{ section.id }} .tst-product-sale-badge {
        position: relative;
        isolation: isolate;
        display: inline-flex;
        flex: 0 0 auto;
        align-items: center;
        justify-content: center;
        min-height: 3.2rem;
        margin: 0 0 7px 0;
        padding: 0.65rem 1.15rem;
        gap: 0.45rem;
        overflow: hidden;
        color: {{ tst_price_block.settings.sale_badge_text_color }};
        background: linear-gradient(135deg, {{ tst_price_block.settings.sale_badge_background }} 0%, {{ tst_price_block.settings.sale_badge_gradient }} 100%);
        border: 1px solid rgba(255, 255, 255, 0.35);
        border-radius: {{ tst_price_block.settings.sale_badge_radius }}px;
        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.22), inset 0 1px 0 rgba(255, 255, 255, 0.28);
        font-size: {{ tst_price_block.settings.sale_badge_font_size }}px;
        font-weight: 700;
        line-height: 1;
        letter-spacing: 0.015em;
        white-space: nowrap;
        text-transform: none;
        animation: tst-product-sale-pulse-{{ section.id }} 1.8s ease-in-out infinite;
      }

      #MainProduct-{{ section.id }} .tst-product-sale-badge::after {
        content: '';
        position: absolute;
        top: -50%;
        bottom: -50%;
        left: -65%;
        z-index: -1;
        width: 45%;
        background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.5), transparent);
        transform: skewX(-22deg);
        animation: tst-product-sale-shine-{{ section.id }} 2.6s ease-in-out infinite;
        pointer-events: none;
      }

      #MainProduct-{{ section.id }} .tst-product-sale-badge__spark {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 0.9em;
        line-height: 1;
        animation: tst-product-sale-spark-{{ section.id }} 1.25s ease-in-out infinite;
      }

      #MainProduct-{{ section.id }} .tst-product-sale-badge strong {
        color: inherit;
        font: inherit;
        font-weight: 800;
      }

      @keyframes tst-product-sale-pulse-{{ section.id }} {
        0%,
        100% {
          transform: scale(1);
          box-shadow: 0 6px 18px rgba(0, 0, 0, 0.22), inset 0 1px 0 rgba(255, 255, 255, 0.28);
          filter: brightness(1);
        }
        50% {
          transform: scale(1.055);
          box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3), 0 0 0 4px rgba(255, 255, 255, 0.12), inset 0 1px 0 rgba(255, 255, 255, 0.35);
          filter: brightness(1.1);
        }
      }

      @keyframes tst-product-sale-shine-{{ section.id }} {
        0%,
        42% {
          left: -65%;
        }
        72%,
        100% {
          left: 130%;
        }
      }

      @keyframes tst-product-sale-spark-{{ section.id }} {
        0%,
        100% {
          opacity: 0.75;
          transform: rotate(0) scale(0.9);
        }
        50% {
          opacity: 1;
          transform: rotate(18deg) scale(1.15);
        }
      }

      @media screen and (max-width: 749px) {
        #MainProduct-{{ section.id }} .tst-product-price-block {
          gap: 0.7rem;
        }

        #MainProduct-{{ section.id }} .tst-product-sale-badge {
          min-height: 2.8rem;
          padding: 0.55rem 0.9rem;
          gap: 0.35rem;
          font-size: {{ tst_price_block.settings.sale_badge_font_size_mobile }}px;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        #MainProduct-{{ section.id }} .tst-product-sale-badge,
        #MainProduct-{{ section.id }} .tst-product-sale-badge::after,
        #MainProduct-{{ section.id }} .tst-product-sale-badge__spark {
          animation: none;
        }
      }
    {%- endif -%}

    #TSTStickyATC-{{ section.id }} .price__badge-sale,
    #TSTStickyATC-{{ section.id }} .tst-product-sale-badge {
      position: relative !important;
      isolation: isolate !important;
      display: inline-flex !important;
      flex: 0 0 auto !important;
      align-items: center !important;
      justify-content: center !important;
      min-height: 3.2rem !important;
      margin: 0 0 7px 0 !important;
      padding: 0.45rem 0.75rem !important;
      gap: 0.45rem !important;
      overflow: hidden !important;
      color: #ffffff !important;
      background: linear-gradient(135deg, #f0522d 0%, #ff8a3d 100%) !important;
      border: 1px solid rgba(255, 255, 255, 0.35) !important;
      border-radius: 20px !important;
      box-shadow: 0 6px 18px rgba(0, 0, 0, 0.22), inset 0 1px 0 rgba(255, 255, 255, 0.28) !important;
      font-size: 13px !important;
      font-weight: 700 !important;
      line-height: 1 !important;
      letter-spacing: 0.015em !important;
      white-space: nowrap !important;
      text-transform: none !important;
      animation: tst-sticky-sale-pulse-{{ section.id }} 1.8s ease-in-out infinite !important;
    }

    #TSTStickyATC-{{ section.id }} .price__badge-sale::after,
    #TSTStickyATC-{{ section.id }} .tst-product-sale-badge::after {
      content: '';
      position: absolute;
      top: -50%;
      bottom: -50%;
      left: -65%;
      z-index: -1;
      width: 45%;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.5), transparent);
      transform: skewX(-22deg);
      animation: tst-sticky-sale-shine-{{ section.id }} 2.6s ease-in-out infinite;
      pointer-events: none;
    }

    #TSTStickyATC-{{ section.id }} .price__badge-sale *,
    #TSTStickyATC-{{ section.id }} .tst-product-sale-badge * {
      color: inherit !important;
    }

    @keyframes tst-sticky-sale-pulse-{{ section.id }} {
      0%,
      100% {
        transform: scale(1);
        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.22), inset 0 1px 0 rgba(255, 255, 255, 0.28);
        filter: brightness(1);
      }
      50% {
        transform: scale(1.055);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3), 0 0 0 4px rgba(255, 255, 255, 0.12), inset 0 1px 0 rgba(255, 255, 255, 0.35);
        filter: brightness(1.1);
      }
    }

    @keyframes tst-sticky-sale-shine-{{ section.id }} {
      0%,
      42% {
        left: -65%;
      }
      72%,
      100% {
        left: 130%;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      #TSTStickyATC-{{ section.id }} .price__badge-sale,
      #TSTStickyATC-{{ section.id }} .price__badge-sale::after,
      #TSTStickyATC-{{ section.id }} .tst-product-sale-badge,
      #TSTStickyATC-{{ section.id }} .tst-product-sale-badge::after {
        animation: none !important;
      }
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
    #MainProduct-{{ section.id }} .product-custom-text {
  width: 100%;
  margin-top: var(--custom-text-margin-top);
  margin-bottom: var(--custom-text-margin-bottom);
  padding: var(--custom-text-padding);
  color: var(--custom-text-color);
  background: var(--custom-text-background);
  border: 1px solid var(--custom-text-border);
  border-radius: var(--custom-text-radius);
  box-sizing: border-box;
}

#MainProduct-{{ section.id }} .product-custom-text__header {
  width: 100%;
  margin-bottom: 1.4rem;
  padding-bottom: 14px;
  border-bottom: 1px solid var(--custom-text-border);
}

#MainProduct-{{ section.id }} .product-custom-text__heading {
  display: block;
  margin: 0;
  color: var(--custom-text-color);
  font-size: 1.6rem;
  font-weight: 600;
  line-height: 1.3;
  letter-spacing: 0.08em;
}

#MainProduct-{{ section.id }} .product-custom-text__field {
  display: flex;
  width: 100%;
  flex-direction: column;
}

#MainProduct-{{ section.id }} .product-custom-text__field + .product-custom-text__field {
  margin-top: 1.5rem;
}

#MainProduct-{{ section.id }} .product-custom-text__label {
  display: block;
  margin: 0 0 0.7rem;
  color: var(--custom-text-color);
  font-size: 1.4rem;
  font-weight: 500;
  line-height: 1.4;
  letter-spacing: 0.06em;
}

#MainProduct-{{ section.id }} .product-custom-text__maximum {
  color: inherit;
}

#MainProduct-{{ section.id }} .product-custom-text__required {
  color: #d72c0d;
}

#MainProduct-{{ section.id }} .product-custom-text__input {
  display: block;
  width: 100%;
  height: auto;
  min-height: 4.6rem;
  margin: 0;
  padding: 1rem 1.3rem;
  color: var(--custom-text-color);
  background: transparent;
  border: 1px solid var(--custom-text-border);
  border-radius: calc(var(--custom-text-radius) * 0.6);
  box-shadow: none;
  outline: none;
  font: inherit;
  line-height: 1.4;
  letter-spacing: 0.04em;
  appearance: none;
  -webkit-appearance: none;
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

#MainProduct-{{ section.id }} .product-custom-text__input::placeholder {
  color: var(--custom-text-muted);
  opacity: 1;
}

#MainProduct-{{ section.id }} .product-custom-text__input:hover {
  border-bottom-color: var(--custom-text-accent);
}

#MainProduct-{{ section.id }} .product-custom-text__input:focus {
  border-color: var(--custom-text-accent);
  outline: none;
  box-shadow: 0 0 0 1px var(--custom-text-accent);
}

#MainProduct-{{ section.id }} .product-custom-text__input.product-custom-text__input--error {
  border-color: #d72c0d !important;
  box-shadow: 0 0 0 1px #d72c0d !important;
}

#MainProduct-{{ section.id }} .product-custom-text__input.product-custom-text__input--error:focus {
  outline: 2px solid rgba(215, 44, 13, 0.18);
  outline-offset: 2px;
}

#MainProduct-{{ section.id }} .product-custom-text__error {
  display: block;
  margin-top: 0.6rem;
  color: #d72c0d;
  font-size: 1.25rem;
  line-height: 1.4;
}

#MainProduct-{{ section.id }} .product-custom-text__error[hidden] {
  display: none;
}

#MainProduct-{{ section.id }} .product-custom-text__helper {
  margin-top: 0.6rem;
  color: var(--custom-text-muted);
  font-size: 1.25rem;
  line-height: 1.5;
}

@media screen and (max-width: 749px) {
  #MainProduct-{{ section.id }} .product-custom-text {
    padding: min(var(--custom-text-padding), 20px);
  }

  #MainProduct-{{ section.id }} .product-custom-text__header {
    margin-bottom: 1.4rem;
    padding-bottom: 12px;
  }
}
/* ATC benefits / trust bar */
#MainProduct-{{ section.id }} .atc-benefits {
  display: grid;
  grid-template-columns: repeat(var(--atc-benefits-columns, 3), minmax(0, 1fr));
  align-items: center;
  width: 100%;
  margin-top: var(--atc-benefits-margin-top);
  margin-bottom: var(--atc-benefits-margin-bottom);
  padding: var(--atc-benefits-padding-vertical) 4px;
  color: var(--atc-benefits-text-color);
  background: var(--atc-benefits-background);
  border-top: var(--atc-benefits-border-width) solid var(--atc-benefits-border-color);
  border-bottom: var(--atc-benefits-border-width) solid var(--atc-benefits-border-color);
  box-sizing: border-box;
}

#MainProduct-{{ section.id }} .atc-benefits__item {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  gap: var(--atc-benefits-item-gap);
  padding: 0 6px;
  color: inherit;
  text-align: center;
  font-size: var(--atc-benefits-font-size);
  font-weight: var(--atc-benefits-font-weight);
  line-height: 1.3;
}

#MainProduct-{{ section.id }} .atc-benefits__item,
#MainProduct-{{ section.id }} .atc-benefits__item * {
  color: inherit;
}

#MainProduct-{{ section.id }} .atc-benefits__icon {
  display: inline-flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  width: var(--atc-benefits-icon-size);
  height: var(--atc-benefits-icon-size);
  font-size: var(--atc-benefits-icon-size);
  line-height: 1;
}

#MainProduct-{{ section.id }} .atc-benefits__icon-image {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: contain;
}

#MainProduct-{{ section.id }} .atc-benefits__text {
  display: block;
  min-width: 0;
  line-height: inherit;
}

#MainProduct-{{ section.id }} .atc-benefits__text p {
  margin: 0;
}

@media screen and (max-width: 749px) {
  #MainProduct-{{ section.id }} .atc-benefits {
    padding-left: 0;
    padding-right: 0;
  }

  #MainProduct-{{ section.id }} .atc-benefits__item {
    gap: max(3px, calc(var(--atc-benefits-item-gap) - 2px));
    padding: 0 3px;
    font-size: min(var(--atc-benefits-font-size), 11px);
  }

  #MainProduct-{{ section.id }} .atc-benefits__icon {
    width: min(var(--atc-benefits-icon-size), 15px);
    height: min(var(--atc-benefits-icon-size), 15px);
    font-size: min(var(--atc-benefits-icon-size), 15px);
  }
}
/* Đồng bộ chiều rộng các block trong cột product info */
@media screen and (min-width: 1334px) {
  #MainProduct-{{ section.id }} .product__info-container {
    width: 100%;
    max-width: none;
  }

  #MainProduct-{{ section.id }} product-form,
  #MainProduct-{{ section.id }} .product-form,
  #MainProduct-{{ section.id }} .product-form__buttons,
  #MainProduct-{{ section.id }} .shopify-payment-button {
    width: 100%;
    max-width: none !important;
  }

  #MainProduct-{{ section.id }} .product-form__submit,
  #MainProduct-{{ section.id }} .shopify-payment-button__button,
  #MainProduct-{{ section.id }} .shopify-payment-button__button--unbranded {
    width: 100% !important;
    max-width: none !important;
  }

  #MainProduct-{{ section.id }} .product-custom-text,
  #MainProduct-{{ section.id }} .atc-benefits,
  #MainProduct-{{ section.id }} .shrine-payment-badges {
    width: 100%;
    max-width: none;
    box-sizing: border-box;
  }
}

{%- if section.settings.mobile_media_full_width -%}
  @media screen and (max-width: 749px) {
    #MainProduct-{{ section.id }} {
      overflow-x: clip;
    }

    #MainProduct-{{ section.id }} .product__media-wrapper {
      width: 100% !important;
      min-width: 0 !important;
      max-width: 100% !important;
      overflow: visible;
    }

    #MainProduct-{{ section.id }} .product__media-wrapper slider-component[id^='GalleryViewer-'] {
      position: relative;
      left: 50%;
      display: block;
      width: 100vw !important;
      width: 100dvw !important;
      min-width: 100vw !important;
      min-width: 100dvw !important;
      max-width: 100vw !important;
      max-width: 100dvw !important;
      margin-right: 0 !important;
      margin-left: -50vw !important;
      margin-left: -50dvw !important;
    }

    #MainProduct-{{ section.id }} .product__media-list {
      --grid-mobile-horizontal-spacing: 0px;
      width: 100% !important;
      margin-right: 0 !important;
      margin-left: 0 !important;
      padding-right: 0 !important;
      padding-left: 0 !important;
      column-gap: 0 !important;
      row-gap: 0 !important;
      scroll-padding-right: 0 !important;
      scroll-padding-left: 0 !important;
    }

    #MainProduct-{{ section.id }} .product__media-list .product__media-item {
      flex: 0 0 100% !important;
      width: 100% !important;
      min-width: 100% !important;
      max-width: 100% !important;
      margin-right: 0 !important;
      margin-left: 0 !important;
      scroll-snap-align: start;
      scroll-snap-stop: always;
    }

    #MainProduct-{{ section.id }} .product__media-list .product-media-container,
    #MainProduct-{{ section.id }} .product__media-list .product__media,
    #MainProduct-{{ section.id }} .product__media-list .media,
    #MainProduct-{{ section.id }} .product__media-list picture {
      width: 100% !important;
      min-width: 100% !important;
      max-width: 100% !important;
      box-sizing: border-box;
    }

    #MainProduct-{{ section.id }} .product__media-list .product__media img,
    #MainProduct-{{ section.id }} .product__media-list .media img {
      display: block;
      width: 100% !important;
      max-width: 100% !important;
    }
  }
{%- endif -%}

@media screen and (max-width: 749px) {
  #MainProduct-{{ section.id }} #Slider-Thumbnails-{{ section.id }} {
    --grid-mobile-horizontal-spacing: 8px;
    column-gap: 8px !important;
    scroll-padding-right: 0 !important;
    scroll-padding-left: 0 !important;
  }

  #MainProduct-{{ section.id }} #Slider-Thumbnails-{{ section.id }} .thumbnail-list__item,
  #MainProduct-{{ section.id }} #Slider-Thumbnails-{{ section.id }} .thumbnail-list__item.slider__slide {
    flex: 0 0 calc((100% - {{ section.settings.mobile_thumbnail_columns | minus: 1 | times: 8 }}px) / {{ section.settings.mobile_thumbnail_columns }}) !important;
    width: calc((100% - {{ section.settings.mobile_thumbnail_columns | minus: 1 | times: 8 }}px) / {{ section.settings.mobile_thumbnail_columns }}) !important;
    min-width: 0 !important;
    max-width: calc((100% - {{ section.settings.mobile_thumbnail_columns | minus: 1 | times: 8 }}px) / {{ section.settings.mobile_thumbnail_columns }}) !important;
    margin-right: 0 !important;
    margin-left: 0 !important;
    box-sizing: border-box;
  }
}
  {%- endstyle -%}

  <script src="{{ 'product-info.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'shrine-product-info.js' | asset_url }}" defer="defer"></script>
  {%- if product.quantity_price_breaks_configured? -%}
    <script src="{{ 'show-more.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'price-per-item.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  {% if section.settings.image_zoom == 'hover' %}
    <script id="EnableZoomOnHover-main" src="{{ 'magnify.js' | asset_url }}" defer="defer"></script>
  {% endif %}
  {%- if request.design_mode -%}
    <script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  {%- assign first_3d_model = product.media | where: 'media_type', 'model' | first -%}
  {%- if first_3d_model -%}
    {{ 'component-product-model.css' | asset_url | stylesheet_tag }}
    <link
      id="ModelViewerStyle"
      rel="stylesheet"
      href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css"
      media="print"
      onload="this.media='all'"
    >
    <link
      id="ModelViewerOverride"
      rel="stylesheet"
      href="{{ 'component-model-viewer-ui.css' | asset_url }}"
      media="print"
      onload="this.media='all'"
    >
  {%- endif -%}

  {% assign variant_images = product.images | where: 'attached_to_variant?', true | map: 'src' %}
  <div class="page-width">
    <div class="product product--{{ section.settings.media_size }} product--{{ section.settings.media_position }} product--{{ section.settings.gallery_layout }} product--mobile-{{ section.settings.mobile_thumbnails }} grid grid--1-col {% if product.media.size > 0 %}grid--2-col-tablet{% else %}product--no-media{% endif %}">
      <div class="grid__item product__media-wrapper">
        {% render 'product-media-gallery', variant_images: variant_images %}
      </div>
      <div class="product__info-wrapper grid__item{% if settings.page_width > 1400 and section.settings.media_size == "small" %} product__info-wrapper--extra-padding{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        <section
          id="ProductInfo-{{ section.id }}"
          class="product__info-container{% if section.settings.enable_sticky_info %} product__column-sticky{% endif %}"
        >
          {%- assign product_form_id = 'product-form-' | append: section.id -%}
          {%- liquid
            assign quantity_atc_append = 'none'
            assign quantity_atc_append_heights = 'stretch-quantity'
            assign quantity_selector_html = ''
          -%}

          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when '@app' -%}
                {% render block %}
              {%- when 'text' -%}
                <p
                  class="product__text inline-richtext{% if block.settings.text_style == 'uppercase' %} caption-with-letter-spacing{% elsif block.settings.text_style == 'subtitle' %} subtitle{% endif %}"
                  {{ block.shopify_attributes }}
                >
                  {{- block.settings.text -}}
                </p>
              {%- when 'title' -%}
                <div class="product__title" {{ block.shopify_attributes }}>
                  <h1>{{ product.title | escape }}</h1>
                  <a href="{{ product.url }}" class="product__title">
                    <h2 class="h1">
                      {{ product.title | escape }}
                    </h2>
                  </a>
                </div>
              {%- when 'rating_stars' -%}
                {% render 'rating-stars-block', block: block %}
              {%- when 'price' -%}
                {%- liquid
                  assign tst_selected_variant = product.selected_or_first_available_variant
                  assign tst_sale_percentage = 0

                  if tst_selected_variant.compare_at_price > tst_selected_variant.price
                    assign tst_sale_saving = tst_selected_variant.compare_at_price | minus: tst_selected_variant.price
                    assign tst_sale_percentage = tst_sale_saving | times: 100.0 | divided_by: tst_selected_variant.compare_at_price | round
                  endif
                -%}
                <div
                  id="price-{{ section.id }}"
                  class="tst-product-price-block"
                  role="status"
                  {{ block.shopify_attributes }}
                >
                  {%- render 'price',
                    product: product,
                    use_variant: true,
                    show_badges: true,
                    price_class: 'price--large'
                  -%}
                  {%- if block.settings.enable_percentage_sale_badge and tst_sale_percentage > 0 -%}
                    <span
                      class="tst-product-sale-badge"
                      aria-label="Sale {{ tst_sale_percentage }} percent"
                    >
                      <span class="tst-product-sale-badge__spark" aria-hidden="true">✦</span>
                      <span>Sale</span>
                      <strong>{{ tst_sale_percentage }}%</strong>
                    </span>
                  {%- endif -%}
                </div>
                {%- if product.quantity_price_breaks_configured? -%}
                  <div class="volume-pricing-note" id="Volume-Note-{{ section.id }}">
                    <span>{{ 'products.product.volume_pricing.note' | t }}</span>
                  </div>
                {%- endif -%}
                {%- if cart.taxes_included or cart.duties_included or shop.shipping_policy.body != blank -%}
                  <div class="product__tax caption rte">
                    {%- if cart.duties_included and cart.taxes_included -%}
                      {{ 'products.product.duties_and_taxes_included' | t }}
                    {%- elsif cart.taxes_included -%}
                      {{ 'products.product.taxes_included' | t }}
                    {%- elsif cart.duties_included -%}
                      {{ 'products.product.duties_included' | t }}
                    {%- endif -%}
                    {%- if shop.shipping_policy.body != blank -%}
                      {{ 'products.product.shipping_policy_html' | t: link: shop.shipping_policy.url }}
                    {%- endif -%}
                  </div>
                {%- endif -%}
                <div {{ block.shopify_attributes }}>
                  {%- assign product_form_installment_id = 'product-form-installment-' | append: section.id -%}
                  {%- form 'product', product, id: product_form_installment_id, class: 'installment caption-large' -%}
                    <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                    {{ form | payment_terms }}
                  {%- endform -%}
                </div>
              {%- when 'inventory' -%}
                <p
                  class="product__inventory{% if block.settings.text_style == 'uppercase' %} caption-with-letter-spacing{% elsif block.settings.text_style == 'subtitle' %} subtitle{% endif %}{% if product.selected_or_first_available_variant.inventory_management != 'shopify' %} visibility-hidden{% endif %}"
                  {{ block.shopify_attributes }}
                  id="Inventory-{{ section.id }}"
                  role="status"
                >
                  {%- if product.selected_or_first_available_variant.inventory_management == 'shopify' -%}
                    {%- if product.selected_or_first_available_variant.inventory_quantity > 0 -%}
                      {%- if product.selected_or_first_available_variant.inventory_quantity
                          <= block.settings.inventory_threshold
                      -%}
                        <span class="svg-wrapper" style="color: rgb(238, 148, 65)">
                          {{- 'icon-inventory-status.svg' | inline_asset_content -}}
                        </span>
                        {%- if block.settings.show_inventory_quantity -%}
                          {{-
                            'products.product.inventory_low_stock_show_count'
                            | t: quantity: product.selected_or_first_available_variant.inventory_quantity
                          -}}
                        {%- else -%}
                          {{- 'products.product.inventory_low_stock' | t -}}
                        {%- endif -%}
                      {%- else -%}
                        <span class="svg-wrapper" style="color: rgb(62, 214, 96)">
                          {{- 'icon-inventory-status.svg' | inline_asset_content -}}
                        </span>
                        {%- if block.settings.show_inventory_quantity -%}
                          {{-
                            'products.product.inventory_in_stock_show_count'
                            | t: quantity: product.selected_or_first_available_variant.inventory_quantity
                          -}}
                        {%- else -%}
                          {{- 'products.product.inventory_in_stock' | t -}}
                        {%- endif -%}
                      {%- endif -%}
                    {%- else -%}
                      {%- if product.selected_or_first_available_variant.inventory_policy == 'continue' -%}
                        <span class="svg-wrapper" style="color: rgb(62, 214, 96)">
                          {{- 'icon-inventory-status.svg' | inline_asset_content -}}
                        </span>
                        {{- 'products.product.inventory_out_of_stock_continue_selling' | t -}}
                      {%- else -%}
                        <span class="svg-wrapper" style="color: rgb(200, 200, 200)">
                          {{- 'icon-inventory-status.svg' | inline_asset_content -}}
                        </span>
                        {{- 'products.product.inventory_out_of_stock' | t -}}
                      {%- endif -%}
                    {%- endif -%}
                  {%- endif -%}
                </p>
              {%- when 'description' -%}
                {%- if product.description != blank -%}
                  <div class="product__description rte quick-add-hidden" {{ block.shopify_attributes }}>
                    {{ product.description }}
                  </div>
                {%- endif -%}
              {%- when 'sku' -%}
                <p
                  class="product__sku{% if block.settings.text_style == 'uppercase' %} caption-with-letter-spacing{% elsif block.settings.text_style == 'subtitle' %} subtitle{% endif %}{% if product.selected_or_first_available_variant.sku.size == 0 %} visibility-hidden{% endif %}"
                  id="Sku-{{ section.id }}"
                  role="status"
                  {{ block.shopify_attributes }}
                >
                  <span class="visually-hidden">{{ 'products.product.sku' | t }}:</span>
                  {{- product.selected_or_first_available_variant.sku -}}
                </p>
              {%- when 'custom_liquid' -%}
                {{ block.settings.custom_liquid }}
               {%- when 'custom_text' -%}
  {%- if block.settings.enable_custom_text or block.settings.enable_custom_year -%}
    <div
      id="ProductCustomText-{{ block.id }}"
      class="product-custom-text color-{{ block.settings.color_scheme }} gradient"
      data-custom-text-block
      data-product-form-id="{{ product_form_id }}"
      style="
        --custom-text-background:
          {% if block.settings.enable_custom_colors %}
            {{ block.settings.custom_background }}
          {% else %}
            rgb(var(--color-background))
          {% endif %};

        --custom-text-color:
          {% if block.settings.enable_custom_colors %}
            {{ block.settings.custom_text_color }}
          {% else %}
            rgb(var(--color-foreground))
          {% endif %};

        --custom-text-muted:
          {% if block.settings.enable_custom_colors %}
            {{ block.settings.custom_muted_color }}
          {% else %}
            rgba(var(--color-foreground), 0.65)
          {% endif %};

        --custom-text-accent:
          {% if block.settings.enable_custom_colors %}
            {{ block.settings.custom_accent_color }}
          {% else %}
            rgb(var(--color-button))
          {% endif %};

        --custom-text-border:
          {% if block.settings.enable_custom_colors %}
            {{ block.settings.custom_border_color }}
          {% else %}
            rgba(var(--color-foreground), 0.18)
          {% endif %};

        --custom-text-radius: {{ block.settings.border_radius }}px;
        --custom-text-padding: {{ block.settings.container_padding }}px;
        --custom-text-margin-top: {{ block.settings.margin_top }}px;
        --custom-text-margin-bottom: {{ block.settings.margin_bottom }}px;
      "
      {{ block.shopify_attributes }}
    >
      {% if block.settings.panel_heading != blank %}
        <div class="product-custom-text__header">
          <span class="product-custom-text__heading">
            {{ block.settings.panel_heading }}
          </span>
        </div>
      {% endif %}

      {%- if block.settings.enable_custom_text -%}
        <div class="product-custom-text__field">
          {% if block.settings.field_label != blank %}
            <label
              class="product-custom-text__label"
              for="CustomTextInput-{{ block.id }}"
            >
              {{ block.settings.field_label }}

              {% if block.settings.required %}
                <span
                  class="product-custom-text__required"
                  aria-hidden="true"
                >
                  *
                </span>
              {% endif %}
            </label>
          {% endif %}

          <input
            id="CustomTextInput-{{ block.id }}"
            class="product-custom-text__input"
            type="text"
            name="properties[{{ block.settings.property_name | default: 'Custom text' | escape }}]"
            placeholder="{{ block.settings.placeholder | escape }}"
            form="{{ product_form_id }}"
            autocomplete="off"
            data-custom-product-field
            data-error-id="CustomTextError-{{ block.id }}"
            {% if block.settings.required %}
              required
              aria-required="true"
              data-custom-required="true"
              data-required-message="Please enter {{ block.settings.field_label | default: 'this field' | escape }}."
            {% endif %}
          >

          <small
            id="CustomTextError-{{ block.id }}"
            class="product-custom-text__error"
            role="alert"
            hidden
          ></small>

          {% if block.settings.helper_text != blank %}
            <div class="product-custom-text__helper">
              {{ block.settings.helper_text }}
            </div>
          {% endif %}
        </div>
      {%- endif -%}

      {%- if block.settings.enable_custom_year -%}
        <div class="product-custom-text__field">
          {% if block.settings.year_field_label != blank %}
            <label
              class="product-custom-text__label"
              for="CustomYearInput-{{ block.id }}"
            >
              {{ block.settings.year_field_label }}

              {% if block.settings.year_required %}
                <span
                  class="product-custom-text__required"
                  aria-hidden="true"
                >
                  *
                </span>
              {% endif %}
            </label>
          {% endif %}

          <input
            id="CustomYearInput-{{ block.id }}"
            class="product-custom-text__input"
            type="text"
            inputmode="numeric"
            pattern="[0-9]{4}"
            minlength="4"
            maxlength="4"
            name="properties[{{ block.settings.year_property_name | default: 'Custom year' | escape }}]"
            placeholder="{{ block.settings.year_placeholder | escape }}"
            form="{{ product_form_id }}"
            autocomplete="off"
            data-custom-product-field
            data-year-field="true"
            data-error-id="CustomYearError-{{ block.id }}"
            data-pattern-message="Please enter a valid 4-digit year."
            {% if block.settings.year_required %}
              required
              aria-required="true"
              data-custom-required="true"
              data-required-message="Please enter {{ block.settings.year_field_label | default: 'a year' | escape }}."
            {% endif %}
          >

          <small
            id="CustomYearError-{{ block.id }}"
            class="product-custom-text__error"
            role="alert"
            hidden
          ></small>

          {% if block.settings.year_helper_text != blank %}
            <div class="product-custom-text__helper">
              {{ block.settings.year_helper_text }}
            </div>
          {% endif %}
        </div>
      {%- endif -%}
    </div>




  {%- endif -%}
              {%- when 'collapsible_tab' -%}
                <div class="product__accordion accordion quick-add-hidden" {{ block.shopify_attributes }}>
                  <details id="Details-{{ block.id }}-{{ section.id }}">
                    <summary>
                      <div class="summary__title">
                        {% render 'icon-accordion', icon: block.settings.icon %}
                        <h2 class="h4 accordion__title inline-richtext">
                          {{ block.settings.heading | default: block.settings.page.title | escape }}
                        </h2>
                      </div>
                      {{- 'icon-caret.svg' | inline_asset_content -}}
                    </summary>
                    <div class="accordion__content rte" id="ProductAccordion-{{ block.id }}-{{ section.id }}">
                      {{ block.settings.content | replace: '[description]', product.description }}
                      {{ block.settings.page.content }}
                    </div>
                  </details>
                </div>
              {%- when 'quantity_selector' -%}
                {%- if block.settings.enable_quantity_discounts -%}
                  {% render 'quantity-breaks', block: block, product: product, product_form_id: product_form_id %}
                {%- else -%}
                  {%- liquid
                    assign quantity_atc_append = block.settings.atc_append
                    assign quantity_atc_append_heights = block.settings.atc_append_heights
                  -%}
                  {%- capture quantity_selector_html -%}
                    <div
                      id="Quantity-Form-{{ section.id }}"
                      class="product-form__input product-form__quantity shrine-quantity-selector{% if block.settings.full_width_classic and block.settings.atc_append == 'none' %} shrine-quantity-selector--full{% endif %}{% if settings.inputs_shadow_vertical_offset != 0 and settings.inputs_shadow_vertical_offset < 0 %} product-form__quantity-top{% endif %}"
                      {{ block.shopify_attributes }}
                      style="--margin-top: {{ block.settings.margin_top | divided_by: 10.0 }}rem; --margin-bottom: {{ block.settings.margin_bottom | divided_by: 10.0 }}rem;"
                    >
                      {% comment %} TODO: enable theme-check once `item_count_for_variant` is accepted as valid filter {% endcomment %}
                      {% # theme-check-disable %}
                      {%- assign cart_qty = cart
                        | item_count_for_variant: product.selected_or_first_available_variant.id
                      -%}
                      {% # theme-check-enable %}
                      <span class="visually-hidden" id="quantity-label-{{ section.id }}">
                        {%- if cart_qty > 0 -%}
                          {{- 'products.product.quantity.in_cart_aria_label' | t: quantity: cart_qty -}}
                        {%- else -%}
                          {{- 'products.product.quantity.label' | t -}}
                        {%- endif -%}
                      </span>
                      <label
                        class="quantity__label form__label"
                        for="Quantity-{{ section.id }}"
                        aria-labelledby="quantity-label-{{ section.id }}"
                      >
                        <span aria-hidden="true">{{ 'products.product.quantity.label' | t }}</span>
                        <span class="quantity__rules-cart{% if cart_qty == 0 %} hidden{% endif %}" aria-hidden="true">
                          {%- render 'loading-spinner' -%}
                          <span
                            >(
                            {{- 'products.product.quantity.in_cart_html' | t: quantity: cart_qty -}}
                            )</span
                          >
                        </span>
                      </label>
                      <div class="price-per-item__container">
                        <quantity-input class="quantity" data-url="{{ product.url }}" data-section="{{ section.id }}">
                          <button class="quantity__button" name="minus" type="button">
                            <span class="visually-hidden">
                              {{- 'products.product.quantity.decrease' | t: product: product.title | escape -}}
                            </span>
                            <span class="svg-wrapper">
                              {{- 'icon-minus.svg' | inline_asset_content -}}
                            </span>
                          </button>
                          <input
                            class="quantity__input"
                            type="number"
                            name="quantity"
                            id="Quantity-{{ section.id }}"
                            data-cart-quantity="{{ cart_qty }}"
                            data-min="{{ product.selected_or_first_available_variant.quantity_rule.min }}"
                            min="{{ product.selected_or_first_available_variant.quantity_rule.min }}"
                            {% if product.selected_or_first_available_variant.quantity_rule.max != null %}
                              data-max="{{ product.selected_or_first_available_variant.quantity_rule.max }}"
                              max="{{ product.selected_or_first_available_variant.quantity_rule.max }}"
                            {% endif %}
                            step="{{ product.selected_or_first_available_variant.quantity_rule.increment }}"
                            value="{{ product.selected_or_first_available_variant.quantity_rule.min }}"
                            form="{{ product_form_id }}"
                          >
                          <button class="quantity__button" name="plus" type="button">
                            <span class="visually-hidden">
                              {{- 'products.product.quantity.increase' | t: product: product.title | escape -}}
                            </span>
                            <span class="svg-wrapper">
                              {{- 'icon-plus.svg' | inline_asset_content -}}
                            </span>
                          </button>
                        </quantity-input>
                      </div>
                      <div class="quantity__rules caption" id="Quantity-Rules-{{ section.id }}">
                        {%- if product.selected_or_first_available_variant.quantity_rule.increment > 1 -%}
                          <span class="divider">
                            {{-
                              'products.product.quantity.multiples_of'
                              | t: quantity: product.selected_or_first_available_variant.quantity_rule.increment
                            -}}
                          </span>
                        {%- endif -%}
                        {%- if product.selected_or_first_available_variant.quantity_rule.min > 1 -%}
                          <span class="divider">
                            {{-
                              'products.product.quantity.minimum_of'
                              | t: quantity: product.selected_or_first_available_variant.quantity_rule.min
                            -}}
                          </span>
                        {%- endif -%}
                        {%- if product.selected_or_first_available_variant.quantity_rule.max != null -%}
                          <span class="divider">
                            {{-
                              'products.product.quantity.maximum_of'
                              | t: quantity: product.selected_or_first_available_variant.quantity_rule.max
                            -}}
                          </span>
                        {%- endif -%}
                      </div>
                    </div>
                  {%- endcapture -%}
                  {%- if quantity_atc_append == 'none' -%}
                    {{ quantity_selector_html }}
                  {%- endif -%}
                {%- endif -%}
              {%- when 'popup' -%}
                <modal-opener
                  class="product-popup-modal__opener quick-add-hidden"
                  data-modal="#PopupModal-{{ block.id }}"
                  {{ block.shopify_attributes }}
                >
                  <button
                    id="ProductPopup-{{ block.id }}"
                    class="product-popup-modal__button link"
                    type="button"
                    aria-haspopup="dialog"
                  >
                    {{ block.settings.text | default: block.settings.page.title | escape }}
                  </button>
                </modal-opener>
              {%- when 'share' -%}
                {% liquid
                  assign share_url = product.selected_variant.url | default: product.url | prepend: request.origin
                  render 'share-button', block: block, share_link: share_url
                %}

              {%- when 'variant_picker' -%}
  {% render 'product-variant-picker', product: product, block: block, product_form_id: product_form_id %}

{%- when 'atc_benefits' -%}
  {%- liquid
    assign benefits_count = 0

    for i in (1..3)
      assign enabled_key = 'enable_item_' | append: i
      assign text_key = 'text_' | append: i

      if block.settings[enabled_key] and block.settings[text_key] != blank
        assign benefits_count = benefits_count | plus: 1
      endif
    endfor
  -%}

  {%- if benefits_count > 0 -%}
    <div
      class="atc-benefits color-{{ block.settings.color_scheme }} gradient"
      style="
        --atc-benefits-columns: {{ benefits_count }};

        --atc-benefits-background:
          {% if block.settings.enable_custom_colors %}
            {{ block.settings.custom_background_color }}
          {% else %}
            rgb(var(--color-background))
          {% endif %};

        --atc-benefits-text-color:
          {% if block.settings.enable_custom_colors %}
            {{ block.settings.custom_text_color }}
          {% else %}
            rgb(var(--color-foreground))
          {% endif %};

        --atc-benefits-border-color:
          {% if block.settings.enable_custom_colors %}
            {{ block.settings.custom_border_color }}
          {% else %}
            rgba(var(--color-foreground), 0.14)
          {% endif %};

        --atc-benefits-border-width: {{ block.settings.border_width }}px;
        --atc-benefits-padding-vertical: {{ block.settings.padding_vertical }}px;
        --atc-benefits-font-size: {{ block.settings.font_size }}px;
        --atc-benefits-font-weight: {{ block.settings.font_weight }};
        --atc-benefits-icon-size: {{ block.settings.icon_size }}px;
        --atc-benefits-item-gap: {{ block.settings.item_gap }}px;
        --atc-benefits-margin-top: {{ block.settings.margin_top }}px;
        --atc-benefits-margin-bottom: {{ block.settings.margin_bottom }}px;
      "
      {{ block.shopify_attributes }}
    >
      {%- for i in (1..3) -%}
        {%- liquid
          assign enabled_key = 'enable_item_' | append: i
          assign image_key = 'icon_image_' | append: i
          assign icon_key = 'icon_' | append: i
          assign text_key = 'text_' | append: i

          assign item_enabled = block.settings[enabled_key]
          assign item_image = block.settings[image_key]
          assign item_icon = block.settings[icon_key]
          assign item_text = block.settings[text_key]
        -%}

        {%- if item_enabled and item_text != blank -%}
          <div class="atc-benefits__item">
            {%- if item_image != blank or item_icon != blank -%}
              <span class="atc-benefits__icon" aria-hidden="true">
                {%- if item_image != blank -%}
                  {{
                    item_image
                    | image_url: width: 80
                    | image_tag:
                      class: 'atc-benefits__icon-image',
                      widths: '20, 40, 60, 80',
                      loading: 'lazy',
                      alt: ''
                  }}
                {%- else -%}
                  {{ item_icon }}
                {%- endif -%}
              </span>
            {%- endif -%}

            <span class="atc-benefits__text">
              {{ item_text }}
            </span>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}


{%- when 'product_upsell' -%}
  {% render 'dawn-product-upsell',
    block: block,
    product: product,
    section: section
  %}

{%- when 'buy_buttons' -%}
                {%- render 'buy-buttons',
                  block: block,
                  product: product,
                  product_form_id: product_form_id,
                  section_id: section.id,
                  show_pickup_availability: true,
                  quantity_selector_html: quantity_selector_html,
                  quantity_atc_append: quantity_atc_append,
                  quantity_atc_append_heights: quantity_atc_append_heights
                -%}
              {%- when 'payment_badges' -%}
                <div
                  class="shrine-payment-badges"
                  style="--margin-top: {{ block.settings.margin_top | divided_by: 10.0 }}rem; --margin-bottom: {{ block.settings.margin_bottom | divided_by: 10.0 }}rem;"
                  {{ block.shopify_attributes }}
                >
                  <ul class="shrine-payment-badges__list" role="list">
                    {% assign enabled_payment_types = shop.enabled_payment_types %}
                    {% if block.settings.enabled_payment_types != blank %}
                      {% assign enabled_payment_types = block.settings.enabled_payment_types | remove: ' ' | split: ',' %}
                    {% endif %}

                    {%- for type in enabled_payment_types -%}
                      {% assign payment_type = type | strip %}
                      <li class="shrine-payment-badges__item">
                        {{ payment_type | payment_type_svg_tag: class: 'icon icon--full-color' }}
                      </li>
                    {%- endfor -%}
                  </ul>
                </div>
              {%- when 'shipping_checkpoints' -%}
                {% render 'shipping-checkpoints', block: block %}
              {%- when 'sticky_atc' -%}
  {%- assign sticky_atc_block = block -%}
              {%- when 'bundle_offer' -%}
                {% render 'bundle-offer', block: block, product: product, section: section %}
              {%- when 'estimated_shipping' -%}
                {% render 'estimated-shipping', block: block %}
              {%- when 'reviews' -%}

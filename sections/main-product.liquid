      {%- if section.settings.enable_variant_media_group -%}
        <style>
          #MediaGallery-{{ section.id }} [data-variant-group-hidden] {
            display: none !important;
          }
        </style>
        <script>
          (() => {
            const sectionId = {{ section.id | json }};
            window.__variantMediaGroupControllers = window.__variantMediaGroupControllers || {};

            if (window.__variantMediaGroupControllers[sectionId]) {
              window.__variantMediaGroupControllers[sectionId].abort();
            }

            const controller = new AbortController();
            const signal = controller.signal;
            window.__variantMediaGroupControllers[sectionId] = controller;

            const normalizeOptionName = (value) => String(value || '')
              .replace(/^options\[/i, '')
              .replace(/\]$/, '')
              .split(':')[0]
              .replace(/-\d+$/, '')
              .trim()
              .toLowerCase();

            const getGallery = () => document.getElementById(`MediaGallery-${sectionId}`);

            const getSelectedOptionValue = (gallery) => {
              const productInfo = gallery.closest('product-info');
              const optionName = normalizeOptionName(gallery.dataset.variantGroupOption);

              if (!productInfo || !optionName) return '';

              const controls = productInfo.querySelectorAll(
                'variant-selects input:checked, variant-selects select, variant-radios input:checked, variant-radios select'
              );

              for (const control of controls) {
                if (normalizeOptionName(control.name) === optionName) {
                  return control.value;
                }
              }

              const fieldsets = productInfo.querySelectorAll('variant-selects fieldset, variant-radios fieldset');
              for (const fieldset of fieldsets) {
                const legend = fieldset.querySelector('legend');
                if (!legend || normalizeOptionName(legend.textContent) !== optionName) continue;
                const checked = fieldset.querySelector('input:checked');
                if (checked) return checked.value;
              }

              return '';
            };

            const getVariantMediaGroup = (gallery, optionValue) => {
              const mapElement = gallery.querySelector('[data-variant-media-group-map]');
              if (!mapElement || !optionValue) return '';

              try {
                const groupMap = JSON.parse(mapElement.textContent);
                const normalizedValue = String(optionValue).trim().toLowerCase();
                const match = groupMap.find((entry) =>
                  entry.group && String(entry.option || '').trim().toLowerCase() === normalizedValue
                );
                return match ? String(match.group).trim().toLowerCase() : '';
              } catch (error) {
                return '';
              }
            };

            const refreshSliders = (gallery, visibleCount) => {
              const viewer = gallery.querySelector(`#GalleryViewer-${sectionId}`);
              const thumbnails = gallery.querySelector(`#GalleryThumbnails-${sectionId}`);
              const total = viewer?.querySelector('.slider-counter--total');

              if (total) total.textContent = visibleCount;

              requestAnimationFrame(() => {
                if (typeof viewer?.initPages === 'function') viewer.initPages();
                if (typeof thumbnails?.initPages === 'function') thumbnails.initPages();
              });
            };

            const applyVariantGroup = () => {
              const gallery = getGallery();
              if (!gallery || gallery.dataset.variantGroupEnabled !== 'true') return;

              const optionValue = getSelectedOptionValue(gallery);
              const commonGroup = String(gallery.dataset.variantGroupCommon || 'group_all').trim().toLowerCase();
              const mappedGroup = getVariantMediaGroup(gallery, optionValue);
              const targetGroup = mappedGroup || String(gallery.dataset.variantGroupInitial || '').trim().toLowerCase();

              if (!targetGroup) return;

              const mediaList = gallery.querySelector(`#Slider-Gallery-${sectionId}`);
              const thumbnailList = gallery.querySelector(`#Slider-Thumbnails-${sectionId}`);
              if (!mediaList) return;

              const mediaItems = Array.from(mediaList.children).filter((item) => item.dataset.mediaGroup !== undefined);
              const thumbnailItems = thumbnailList
                ? Array.from(thumbnailList.children).filter((item) => item.dataset.mediaGroup !== undefined)
                : [];

              const hasTargetGroup = mediaItems.some(
                (item) => String(item.dataset.mediaGroup || '').trim().toLowerCase() === targetGroup
              );

              const shouldShow = (item) => {
                if (!hasTargetGroup) return true;
                const itemGroup = String(item.dataset.mediaGroup || '').trim().toLowerCase();
                return !itemGroup || itemGroup === targetGroup || itemGroup === commonGroup;
              };

              mediaItems.forEach((item) => {
                const hidden = !shouldShow(item);
                item.hidden = hidden;
                item.toggleAttribute('data-variant-group-hidden', hidden);
                if (!hidden) item.classList.remove('scroll-trigger--offscreen');
              });

              thumbnailItems.forEach((item) => {
                const hidden = !shouldShow(item);
                item.hidden = hidden;
                item.toggleAttribute('data-variant-group-hidden', hidden);
              });

              const visibleMedia = mediaItems.filter((item) => !item.hidden);
              const activeMedia = mediaList.querySelector('.product__media-item.is-active');
              const groupChanged = gallery.dataset.variantGroupCurrent !== targetGroup;

              if (visibleMedia.length && (groupChanged || !activeMedia || activeMedia.hidden)) {
                const preferredMedia = visibleMedia.find(
                  (item) => String(item.dataset.mediaGroup || '').trim().toLowerCase() === targetGroup
                ) || visibleMedia[0];

                if (typeof gallery.setActiveMedia === 'function') {
                  gallery.setActiveMedia(preferredMedia.dataset.mediaId, true);
                } else {
                  mediaItems.forEach((item) => item.classList.toggle('is-active', item === preferredMedia));
                  preferredMedia.scrollIntoView({ behavior: 'auto', block: 'nearest', inline: 'nearest' });
                }

                thumbnailItems.forEach((item) => {
                  const button = item.querySelector('.thumbnail');
                  if (button) {
                    if (item.dataset.target === preferredMedia.dataset.mediaId) {
                      button.setAttribute('aria-current', 'true');
                    } else {
                      button.removeAttribute('aria-current');
                    }
                  }
                });
              }

              gallery.dataset.variantGroupCurrent = targetGroup;
              refreshSliders(gallery, visibleMedia.length);
            };

            let applyFrame = 0;
            let applyTimerShort = 0;
            let applyTimerLong = 0;

            const scheduleApply = () => {
              if (applyFrame) cancelAnimationFrame(applyFrame);
              if (applyTimerShort) window.clearTimeout(applyTimerShort);
              if (applyTimerLong) window.clearTimeout(applyTimerLong);

              applyFrame = requestAnimationFrame(() => {
                applyFrame = 0;
                applyVariantGroup();
              });

              applyTimerShort = window.setTimeout(() => {
                applyTimerShort = 0;
                applyVariantGroup();
              }, 120);

              applyTimerLong = window.setTimeout(() => {
                applyTimerLong = 0;
                applyVariantGroup();
              }, 450);
            };

            const initialize = () => {
              const gallery = getGallery();
              if (!gallery) return;

              if (customElements.get('media-gallery')) {
                applyVariantGroup();
              } else {
                customElements.whenDefined('media-gallery').then(applyVariantGroup);
              }
            };

            document.addEventListener('change', (event) => {
              const gallery = getGallery();
              const productInfo = gallery?.closest('product-info');
              if (productInfo && productInfo.contains(event.target)) scheduleApply();
            }, { capture: true, signal });

            document.addEventListener('variant:change', scheduleApply, { signal });
            document.addEventListener('shopify:section:load', (event) => {
              if (event.detail?.sectionId === sectionId || event.target.querySelector?.(`#MediaGallery-${sectionId}`)) {
                scheduleApply();
              }
            }, { signal });
            document.addEventListener('shopify:section:unload', (event) => {
              if (event.detail?.sectionId === sectionId) {
                if (applyFrame) cancelAnimationFrame(applyFrame);
                if (applyTimerShort) window.clearTimeout(applyTimerShort);
                if (applyTimerLong) window.clearTimeout(applyTimerLong);
                controller.abort();
              }
            }, { signal });

            if (document.readyState === 'loading') {
              document.addEventListener('DOMContentLoaded', initialize, { once: true, signal });
            } else {
              initialize();
            }
          })();
        </script>
      {%- endif -%}
    {%- endif -%}

    {%- if first_3d_model -%}

{"sections":{"main":{"type":"main-page","disabled":true,"settings":{"padding_top":28,"padding_bottom":28}},"rich_text_8DKpEq":{"type":"rich-text","blocks":{"heading_KyfwJR":{"type":"heading","settings":{"heading":"WE DON'T COMMODITIZE. WE CRAFT.","highlight_text":"WE CRAFT.","highlight_color":"#e65f2b","highlight_bold":true,"heading_size":"h1"}}},"block_order":["heading_KyfwJR"],"custom_css":["@media (min-width: 1024px) {.rich-text__heading {font-size: 63px; }}"],"name":"t:sections.rich-text.presets.name","settings":{"desktop_content_position":"center","content_alignment":"center","color_scheme":"","full_width":true,"padding_top":40,"padding_bottom":52}},"image_with_text_VMr7MY":{"type":"image-with-text","blocks":{"caption_tQGkYL":{"type":"caption","settings":{"caption":"OUR STORY","text_style":"caption-with-letter-spacing","text_size":"medium"}},"heading_8hEQV4":{"type":"heading","settings":{"heading":"BUILT SMALL. MADE TO LAST.","heading_size":"h1"}},"text_8wE3nK":{"type":"text","settings":{"text":"<p>We’re a small independent business with a simple goal: create outdoor hats we’d be proud to wear ourselves.<\/p><p>Our hats are <strong>made in Vietnam<\/strong>, a country with a long tradition of skilled textile and garment craftsmanship. Each design is created with close attention to embroidery, materials, fit, and everyday durability.<\/p><p>Being a small business means we care about the details — from the way a hat looks and feels to the way every order is checked before it leaves us. We’re not trying to be the biggest brand out there. We simply want to make dependable headwear for people who feel at home outdoors.<\/p><p><strong>Thank you for supporting a small business and the people behind every piece.<\/strong><\/p><p><\/p>","text_style":"body"}}},"block_order":["caption_tQGkYL","heading_8hEQV4","text_8wE3nK"],"name":"t:sections.image-with-text.presets.name","settings":{"image":"shopify:\/\/shop_images\/tonegift_review_16.png","height":"adapt","desktop_image_width":"medium","layout":"text_first","image_behavior":"none","content_layout":"no-overlap","desktop_content_position":"middle","desktop_content_alignment":"left","mobile_content_alignment":"left","section_color_scheme":"","color_scheme":"","padding_top":36,"padding_bottom":36}},"image_with_text_zFpTiX":{"type":"image-with-text","blocks":{"caption_9QrqhA":{"type":"caption","settings":{"caption":"OUR CRAFT","text_style":"caption-with-letter-spacing","text_size":"medium"}},"heading_YAyc8Y":{"type":"heading","settings":{"heading":"MADE WITH CARE. BUILT FOR THE OUTDOORS.","heading_size":"h1"}},"text_it47h7":{"type":"text","settings":{"text":"<p>Our hats are made in Vietnam by skilled makers with experience in textile, stitching, and embroidery craftsmanship. From the structured crown and curved brim to the embroidered details, every element is chosen with comfort, durability, and everyday wear in mind.<\/p><p>As a small business, we pay close attention to the details that matter. Each hat is checked for its overall appearance, embroidery, stitching, and construction before it is prepared for shipment.<\/p><p>No unnecessary hype. Just thoughtfully made headwear designed for hunting trips, weekends outdoors, and wherever the trail takes you.<\/p><p><strong>Made in Vietnam. Checked with care. Built to be worn.<\/strong><\/p><p><\/p>","text_style":"body"}}},"block_order":["caption_9QrqhA","heading_YAyc8Y","text_it47h7"],"name":"t:sections.image-with-text.presets.name","settings":{"image":"shopify:\/\/shop_images\/1724c614-5b6f-47c0-b5a2-03a1e7a3e7fd.png","height":"adapt","desktop_image_width":"medium","layout":"image_first","image_behavior":"none","content_layout":"no-overlap","desktop_content_position":"middle","desktop_content_alignment":"left","mobile_content_alignment":"left","section_color_scheme":"","color_scheme":"","padding_top":36,"padding_bottom":36}},"tst_workshop_archives_zVa8Bf":{"type":"tst-workshop-archives","blocks":{"archive_item_AQbUAh":{"type":"archive_item","settings":{"image":"shopify:\/\/shop_images\/426b2e9a-3391-4cfa-9bfa-83bcdfa5f7f4.png","badge_text":"FIELD-TESTED GEAR","link":""}},"archive_item_XRKzTt":{"type":"archive_item","settings":{"image":"shopify:\/\/shop_images\/38899710-3859-49b1-8d43-afe64cd43c78.png","badge_text":"PREMIUM OUTDOOR GEAR","link":""}},"archive_item_nfkHCW":{"type":"archive_item","settings":{"image":"shopify:\/\/shop_images\/421842b7-ad8c-4d84-a1b3-ce101563726f.png","badge_text":"ESSENTIAL EQUIPMENT","link":""}},"archive_item_AwWmAx":{"type":"archive_item","settings":{"image":"shopify:\/\/shop_images\/b6ff234a-dd2f-4893-929b-5425be018867.png","badge_text":"BORN FOR THE OUTDOORS","link":""}}},"block_order":["archive_item_AQbUAh","archive_item_XRKzTt","archive_item_nfkHCW","archive_item_AwWmAx"],"name":"TST Workshop archives","settings":{"heading":"EQUIPPING YOUR JOURNEY","location_text":"BUILT TO LAST","section_width":"default","columns_desktop":2,"columns_mobile":"1","image_ratio":"landscape","background_color":"#0d0d0d","text_color":"#f2f2f2","accent_color":"#ff9d84","badge_background":"#101010","badge_text_color":"#ff9d84","heading_size_desktop":52,"heading_size_mobile":36,"heading_weight":"600","location_size":14,"location_size_mobile":12,"badge_size":14,"badge_size_mobile":11,"grid_gap":24,"grid_gap_mobile":16,"header_spacing":64,"header_spacing_mobile":32,"card_radius":0,"badge_offset":16,"badge_offset_mobile":10,"hover_zoom":104,"full_width_padding":52,"mobile_padding":16,"padding_top":48,"padding_bottom":48,"padding_top_mobile":32,"padding_bottom_mobile":32}},"rich_text_WwBJPC":{"type":"rich-text","blocks":{"heading_4idcAQ":{"type":"heading","settings":{"heading":"The Vanguard.","highlight_text":"","highlight_color":"#ff6b00","highlight_bold":true,"heading_size":"h1"}},"text_cKAbfz":{"type":"text","settings":{"text":"<p>The architects of endurance. We are leathersmiths, designers, and guides dedicated to the pursuit of the absolute.<\/p>"}}},"block_order":["heading_4idcAQ","tex